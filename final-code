CountReservedTables PROC USES esi
    LOCAL count:DWORD, row:DWORD
    mov  count, 0
    mov  row, 0
CRT_Loop:
    mov  eax, row
    cmp  eax, TABLE_COUNT
    jae  CRT_Done
    shl  eax, 2
    lea  esi, tableSeats
    cmp  BYTE PTR [esi+eax], 0
    je   CRT_Next
    inc  count
CRT_Next:
    inc  row
    jmp  CRT_Loop
CRT_Done:
    mov  eax, count
    ret
CountReservedTables ENDP

CountActiveOrders PROC USES esi
    LOCAL count:DWORD, idx:DWORD
    mov  count, 0
    mov  idx, 0
CAO_Loop:
    mov  eax, idx
    cmp  eax, TABLE_COUNT
    jae  CAO_Done
    lea  esi, orderLineCount
    cmp  DWORD PTR [esi+eax*4], 0
    je   CAO_Next
    inc  count
CAO_Next:
    inc  idx
    jmp  CAO_Loop
CAO_Done:
    mov  eax, count
    ret
CountActiveOrders ENDP

ShowTablesWithOrders PROC USES esi ebx
