    cmp  eax, TABLE_COUNT
    jae  DT_Done

    inc  eax
    INVOKE WriteDecPadded, eax, 4
    mov  edx, OFFSET gridBar
    call WriteString

    mov  col, 0
DT_Col:
    mov  eax, col
    cmp  eax, SEATS_PER_TABLE
    jae  DT_Status

    mov  eax, row
    shl  eax, 2
    add  eax, col
    lea  esi, tableSeats
    movzx eax, BYTE PTR [esi+eax]
    test eax, eax
    jz   DT_FreeSeat
    mov  al, 'X'
    jmp  DT_PrintSeat
DT_FreeSeat:
    mov  al, '.'
DT_PrintSeat:
    call WriteChar
    mov  al, ' '
    call WriteChar
    inc  col
    jmp  DT_Col

DT_Status:
    mov  edx, OFFSET gridBar
    call WriteString
    mov  eax, row
    shl  eax, 2
    lea  esi, tableSeats
    cmp  BYTE PTR [esi+eax], 0
    je   DT_Available

    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET statusReserved
    call WriteString
    mov  eax, row
    lea  esi, tableParty
