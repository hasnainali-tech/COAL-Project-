AdminLogin PROC
LoginRetry:
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET loginBanner
    call WriteString

    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET loginHint
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET promptUser
    call WriteString
    mov  edx, OFFSET userBuf
    mov  ecx, 32
    call ReadString

    mov  edx, OFFSET promptPass
    call WriteString
    INVOKE ReadPassword, OFFSET passBuf, 32

    INVOKE Str_length, OFFSET userBuf
    INVOKE VerifyString, OFFSET adminUser, OFFSET userBuf, ADMIN_USER_LEN, eax
    test eax, eax
    jz   LoginFailed

    INVOKE Str_length, OFFSET passBuf
    INVOKE VerifyString, OFFSET adminPass, OFFSET passBuf, ADMIN_PASS_LEN, eax
    test eax, eax
    jz   LoginFailed

    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgLoginOK
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  eax, 800
    call Delay
    ret

LoginFailed:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgBadLogin
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  eax, 1200
    call Delay
    jmp  LoginRetry
AdminLogin ENDP

ReadKeyWait PROC USES ebx
    LOCAL hIn:DWORD
    LOCAL rec:INPUT_RECORD
    LOCAL nRead:DWORD

    INVOKE GetStdHandle, STD_INPUT_HANDLE
    mov  hIn, eax
RKW_Retry:
    INVOKE ReadConsoleInput, hIn, ADDR rec, 1, ADDR nRead
    cmp  nRead, 1
    jne  RKW_Retry
    movzx eax, rec.EventType
    cmp  eax, KEY_EVENT
    jne  RKW_Retry
    cmp  rec.Event.bKeyDown, 0
    je   RKW_Retry
    movzx eax, rec.Event.uChar.AsciiChar
    ret
ReadKeyWait ENDP

ReadPassword PROC USES esi, pBuffer:PTR BYTE, maxLen:DWORD
    LOCAL count:DWORD

    mov  count, 0
    mov  esi, pBuffer
RP_Loop:
    call ReadKeyWait
    cmp  al, 13
    je   RP_Done
    cmp  al, 8
    je   RP_Backspace
    cmp  al, 32
    jb   RP_Loop
    cmp  al, 126
    ja   RP_Loop
    mov  ecx, count
    cmp  ecx, maxLen
    jae  RP_Loop
    mov  BYTE PTR [esi+ecx], al
    inc  count
    mov  al, '*'
    call WriteChar
    jmp  RP_Loop

RP_Backspace:
    cmp  count, 0
    je   RP_Loop
    dec  count
    mov  al, 8
    call WriteChar
    mov  al, ' '
    call WriteChar
    mov  al, 8
    call WriteChar
    jmp  RP_Loop

RP_Done:
    mov  ecx, count
    mov  BYTE PTR [esi+ecx], 0
    call Crlf
    mov  eax, count
    ret
ReadPassword ENDP

ReadNumber PROC USES esi ebx
    LOCAL buf[16]:BYTE
    LOCAL digit:DWORD

    lea  edx, buf
    mov  ecx, 12
    call ReadString
    mov  ecx, eax
    test ecx, ecx
    jz   RN_Error

    lea  esi, buf
RN_Lead:
    mov  al, BYTE PTR [esi]
    cmp  al, ' '
    je   RN_SkipLead
    cmp  al, 9
    je   RN_SkipLead
    jmp  RN_Start
RN_SkipLead:
    inc  esi
    dec  ecx
    jz   RN_Error
    jmp  RN_Lead

RN_Start:
    xor  eax, eax
RN_Digit:
    movzx edx, BYTE PTR [esi]
    cmp  dl, ' '
    je   RN_Trail
    cmp  dl, 9
    je   RN_Trail
    sub  edx, '0'
    cmp  edx, 9
    ja   RN_Error
    mov  digit, edx
    mov  ebx, 10
    mul  ebx
    test edx, edx
    jnz  RN_Error
    add  eax, digit
    jc   RN_Error
    inc  esi
    dec  ecx
    jz   RN_Ok
    jmp  RN_Digit

RN_Trail:
    mov  dl, BYTE PTR [esi]
    cmp  dl, ' '
    je   RN_TrailNext
    cmp  dl, 9
    jne  RN_Error
RN_TrailNext:
    inc  esi
    dec  ecx
    jz   RN_Ok
    jmp  RN_Trail

RN_Ok:
    clc
    ret
RN_Error:
    xor  eax, eax
    stc
    ret
ReadNumber ENDP

; exact byte comparison using CMPSB
VerifyString PROC USES esi edi ecx, pStored:PTR BYTE, pEntered:PTR BYTE, storedLen:DWORD, enteredLen:DWORD
    mov  eax, 0
    mov  ecx, storedLen
    cmp  ecx, enteredLen
    jne  VS_Done
    test ecx, ecx
    jz   VS_Match

    mov  esi, pStored
    mov  edi, pEntered
    cld
    repe cmpsb                          ; compare bytes until mismatch
    jne  VS_Done

VS_Match:
    mov  eax, 1
VS_Done:
    ret
VerifyString ENDP

