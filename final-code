FinalizeOrder PROC USES esi edi ebx, tableIdx:DWORD

    mov  eax, tableIdx
    shl  eax, 2
    lea  edi, tableSeats
    add  edi, eax
    mov  ecx, SEATS_PER_TABLE
    xor  eax, eax
    rep  stosb

    mov  eax, tableIdx
    lea  esi, tableParty
    mov  BYTE PTR [esi+eax], 0

    lea  esi, orderLineCount
    mov  DWORD PTR [esi+eax*4], 0
    lea  esi, orderSubtotalLo
    mov  DWORD PTR [esi+eax*4], 0
    lea  esi, orderSubtotalHi
    mov  DWORD PTR [esi+eax*4], 0

    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    lea  edi, orderItem
    add  edi, eax
    mov  ecx, MAX_ORDER_LINES
    xor  eax, eax
    rep  stosd

    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    lea  edi, orderQty
    add  edi, eax
    mov  ecx, MAX_ORDER_LINES
    xor  eax, eax
    rep  stosd

    inc  receiptNo
    ret
FinalizeOrder ENDP

UIntToStr PROC USES ebx ecx edx edi, value:DWORD, pBuffer:PTR BYTE
    mov  eax, value
    mov  edi, pBuffer
    cmp  eax, 0
    jne  UTS_NonZero
    mov  BYTE PTR [edi], '0'
    mov  BYTE PTR [edi+1], 0
    mov  eax, 1
    ret

UTS_NonZero:
    xor  ecx, ecx
    mov  ebx, 10
UTS_DivLoop:
    xor  edx, edx
    div  ebx
    push edx
    inc  ecx
    test eax, eax
    jnz  UTS_DivLoop

    mov  eax, ecx
UTS_StoreLoop:
    pop  edx
    add  dl, '0'
    mov  BYTE PTR [edi], dl
    inc  edi
    dec  ecx
    jnz  UTS_StoreLoop
    mov  BYTE PTR [edi], 0
    ret
UIntToStr ENDP

WriteStrToFile PROC USES eax ecx edx, hFile:DWORD, pString:PTR BYTE
    LOCAL bytesWritten:DWORD
    INVOKE Str_length, pString
    mov  ecx, eax
    jecxz WSTF_Done
    INVOKE WriteFile, hFile, pString, ecx, ADDR bytesWritten, NULL
WSTF_Done:
    ret
WriteStrToFile ENDP

WriteDecToFile PROC USES eax, hFile:DWORD, value:DWORD
    INVOKE UIntToStr, value, ADDR numStrBuffer
    INVOKE WriteStrToFile, hFile, ADDR numStrBuffer
    ret
WriteDecToFile ENDP

AppendReceiptToFile PROC USES eax ebx ecx edx esi edi, tableIdx:DWORD
    LOCAL hFile:DWORD
    LOCAL i:DWORD
    LOCAL itemIdx:DWORD
    LOCAL qty:DWORD
    LOCAL lineTotal:DWORD
    LOCAL guestCount:DWORD
    LOCAL tableNo:DWORD
    LOCAL lineBase:DWORD
    LOCAL lineCount:DWORD

    INVOKE CreateFile, ADDR recordsFileName, GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL
    cmp  eax, INVALID_HANDLE_VALUE
    je   ARF_Error
    mov  hFile, eax

    INVOKE SetFilePointer, hFile, 0, NULL, FILE_END

    INVOKE WriteStrToFile, hFile, ADDR fileRecSep
    INVOKE WriteStrToFile, hFile, ADDR fileRecTitle
    INVOKE WriteDecToFile, hFile, receiptNo
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    mov  eax, tableIdx
    inc  eax
    mov  tableNo, eax
    INVOKE WriteStrToFile, hFile, ADDR fileRecTable
    INVOKE WriteDecToFile, hFile, tableNo
    INVOKE WriteStrToFile, hFile, ADDR fileRecGuests
    mov  eax, tableIdx
    lea  esi, tableParty
    movzx eax, BYTE PTR [esi+eax]
    mov  guestCount, eax
    INVOKE WriteDecToFile, hFile, guestCount
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    mov  eax, tableIdx
    lea  esi, orderLineCount
    mov  eax, DWORD PTR [esi+eax*4]
    mov  lineCount, eax
    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    mov  lineBase, eax

    mov  i, 0
ARF_ItemLoop:
    mov  eax, i
    cmp  eax, lineCount
    jae  ARF_ItemsDone

    mov  ecx, lineBase
    lea  esi, orderItem
    add  esi, ecx
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    mov  itemIdx, eax

    mov  ecx, lineBase
    lea  esi, orderQty
    add  esi, ecx
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    mov  qty, eax

    INVOKE WriteStrToFile, hFile, ADDR fileItemSep
    mov  eax, itemIdx
    lea  esi, menuNames
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WriteStrToFile, hFile, edx
    INVOKE WriteStrToFile, hFile, ADDR fileQtySep
    INVOKE WriteDecToFile, hFile, qty

    mov  eax, itemIdx
    lea  esi, menuPrices
    mov  eax, DWORD PTR [esi+eax*4]
    mov  ecx, qty
    mul  ecx
    mov  lineTotal, eax
    INVOKE WriteStrToFile, hFile, ADDR fileLineSep
    INVOKE WriteDecToFile, hFile, lineTotal
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    inc  i
    jmp  ARF_ItemLoop

ARF_ItemsDone:

    INVOKE WriteStrToFile, hFile, ADDR fileRecItems
    INVOKE WriteDecToFile, hFile, lineCount
    INVOKE WriteStrToFile, hFile, ADDR fileRecSubtotal
    INVOKE WriteDecToFile, hFile, billSubtotal
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    INVOKE WriteStrToFile, hFile, ADDR fileRecTax
    INVOKE WriteDecToFile, hFile, billTax
    INVOKE WriteStrToFile, hFile, ADDR fileRecDiscount
    INVOKE WriteDecToFile, hFile, billDiscount
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    INVOKE WriteStrToFile, hFile, ADDR fileRecFinal
    INVOKE WriteDecToFile, hFile, billFinal
    INVOKE WriteStrToFile, hFile, ADDR fileRecPoints
    INVOKE WriteDecToFile, hFile, billPoints
    INVOKE WriteStrToFile, hFile, ADDR fileBlankLine

    INVOKE CloseHandle, hFile
    ret

ARF_Error:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgFileWriteErr
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    ret
AppendReceiptToFile ENDP

ViewFiledRecords PROC USES eax ebx ecx edx esi edi
    LOCAL hFile:DWORD
    LOCAL bytesRead:DWORD

    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET fileTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    INVOKE CreateFile, ADDR recordsFileName, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL
    cmp  eax, INVALID_HANDLE_VALUE
    je   VFR_NoFile
    mov  hFile, eax

VFR_ReadLoop:
    INVOKE ReadFile, hFile, ADDR fileBuffer, FILE_BUF_SIZE - 1, ADDR bytesRead, NULL
    cmp  bytesRead, 0
    je   VFR_Done
    mov  eax, bytesRead
    lea  edi, fileBuffer
    mov  BYTE PTR [edi+eax], 0
    mov  edx, OFFSET fileBuffer
    call WriteString
    jmp  VFR_ReadLoop

VFR_Done:
    INVOKE CloseHandle, hFile
    call Crlf
    call WaitEnter
    ret

VFR_NoFile:
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgNoFile
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret
ViewFiledRecords ENDP

ToLowerChar PROC charVal:DWORD
    mov  eax, charVal
    cmp  al, 'A'
    jb   TLC_Done
    cmp  al, 'Z'
    ja   TLC_Done
    add  al, 32
TLC_Done:
    movzx eax, al
    ret
ToLowerChar ENDP

StrContainsInsensitive PROC USES ebx ecx edx esi edi, pHaystack:PTR BYTE, pNeedle:PTR BYTE
    LOCAL hLen:DWORD
    LOCAL nLen:DWORD
    LOCAL i:DWORD
    LOCAL j:DWORD

    INVOKE Str_length, pHaystack
    mov  hLen, eax
    INVOKE Str_length, pNeedle
    mov  nLen, eax

    cmp  nLen, 0
    je   SCI_Found
    mov  eax, hLen
    cmp  eax, nLen
    jb   SCI_NotFound

    mov  eax, hLen
    sub  eax, nLen
    mov  ecx, eax
    mov  i, 0

SCI_Outer:
    mov  eax, i
    cmp  eax, ecx
    ja   SCI_NotFound

    mov  j, 0
SCI_Inner:
    mov  eax, j
    cmp  eax, nLen
    jae  SCI_Found

    mov  esi, pHaystack
    add  esi, i
    add  esi, j
    movzx ebx, BYTE PTR [esi]
    INVOKE ToLowerChar, bl
    mov  bl, al

    mov  edi, pNeedle
    add  edi, j
    movzx edx, BYTE PTR [edi]
    push ebx
    INVOKE ToLowerChar, dl
    pop  ebx
    cmp  bl, al
    jne  SCI_NextOuter

    inc  j
    jmp  SCI_Inner

SCI_NextOuter:
    inc  i
    jmp  SCI_Outer

SCI_Found:
    mov  eax, 1
    ret
SCI_NotFound:
    xor  eax, eax
    ret
StrContainsInsensitive ENDP

SearchMenuItem PROC USES esi edi ebx
    LOCAL choice:DWORD
    LOCAL itemNo:DWORD
    LOCAL i:DWORD
    LOCAL found:DWORD
    LOCAL inLen:DWORD
    LOCAL pNeedle:PTR BYTE

SM_Retry:
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET searchTitle
    call WriteString
    mov  eax, COLOR_MENU
    call SetTextColor
    mov  edx, OFFSET searchMenu
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET promptSearchMode
    call WriteString
    call ReadNumber
    jc   SM_BadMode
    mov  choice, eax
    cmp  eax, 0
    je   SM_Done
    cmp  eax, 1
    je   SM_ByNumber
    cmp  eax, 2
    je   SM_ByName
    jmp  SM_BadMode

SM_ByNumber:
    mov  edx, OFFSET promptSearchNum
    call WriteString
    call ReadNumber
    jc   SM_BadNum
    cmp  eax, 1
    jb   SM_BadNum
    cmp  eax, MAX_ITEMS
    ja   SM_BadNum
    mov  itemNo, eax

    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET msgSearchFound
    call WriteString
    mov  edx, OFFSET msgSearchHeader
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  eax, itemNo
    dec  eax
    mov  i, eax

    mov  eax, i
    inc  eax
    INVOKE WriteDecPadded, eax, 3
    mov  edx, OFFSET colSep
    call WriteString
    lea  esi, menuNames
    mov  eax, i
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WritePadded, edx, 24
    lea  esi, menuPrices
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 9
    lea  esi, menuStock
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 7
    call Crlf
    mov  edx, OFFSET menuDivider
    call WriteString
    call WaitEnter
    ret

SM_ByName:
    mov  edx, OFFSET promptSearchName
    call WriteString
    mov  edx, OFFSET searchBuf
    mov  ecx, SEARCH_BUF_SIZE - 1
    call ReadString
    mov  inLen, eax
    test eax, eax
    jz   SM_EmptyName

    lea  esi, searchBuf
SM_TrimCheck:
    mov  al, BYTE PTR [esi]
    cmp  al, 0
    je   SM_EmptyName
    cmp  al, ' '
    je   SM_TrimNext
    cmp  al, 9
    je   SM_TrimNext
    jmp  SM_DoSearch
SM_TrimNext:
    inc  esi
    jmp  SM_TrimCheck

SM_DoSearch:
    mov  pNeedle, esi
    mov  found, 0
    mov  i, 0

SM_SearchLoop:
    mov  eax, i
    cmp  eax, MAX_ITEMS
    jae  SM_SearchDone

    lea  esi, menuNames
    mov  eax, i
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE StrContainsInsensitive, edx, pNeedle
    test eax, eax
    jz   SM_SearchNext

    cmp  found, 0
    jne  SM_PrintMatch
    mov  found, 1
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET msgSearchFound
    call WriteString
    mov  edx, OFFSET msgSearchHeader
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

SM_PrintMatch:
    mov  eax, i
    inc  eax
    INVOKE WriteDecPadded, eax, 3
    mov  edx, OFFSET colSep
    call WriteString
    lea  esi, menuNames
    mov  eax, i
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WritePadded, edx, 24
    lea  esi, menuPrices
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 9
    lea  esi, menuStock
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 7
    call Crlf

SM_SearchNext:
    inc  i
    jmp  SM_SearchLoop

SM_SearchDone:
    cmp  found, 0
    je   SM_NoMatch
    mov  edx, OFFSET menuDivider
    call WriteString
    call WaitEnter
    ret

SM_NoMatch:
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgSearchNone
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

SM_BadMode:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgSearchInvalid
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  SM_Retry

SM_BadNum:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgSearchNumBad
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  SM_Retry

SM_EmptyName:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgSearchEmpty
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  SM_Retry

SM_Done:
    ret
SearchMenuItem ENDP

