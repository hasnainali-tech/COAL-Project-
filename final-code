; ----------------------------------------------------------------------------
; ShowStatusLine - one-line status of orders, reservations and receipts.
; ----------------------------------------------------------------------------
ShowStatusLine PROC
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET statusPrefix
    call WriteString

    call CountActiveOrders
    test eax, eax
    jz   SSL_Idle
    push eax
    mov  edx, OFFSET msgStatusActive
    call WriteString
    pop  eax
    call WriteDec
    jmp  SSL_Tables
SSL_Idle:
    mov  edx, OFFSET msgStatusIdle
    call WriteString

SSL_Tables:
    mov  edx, OFFSET msgTablesReserved
    call WriteString
    call CountReservedTables
    call WriteDec
    mov  edx, OFFSET msgOf
    call WriteString
    mov  eax, TABLE_COUNT
    call WriteDec

    mov  edx, OFFSET msgReceipts
    call WriteString
    mov  eax, receiptNo
    dec  eax                           ; receipts already issued
    call WriteDec
    call Crlf

    mov  eax, COLOR_NORMAL
    call SetTextColor
    ret
ShowStatusLine ENDP

; ----------------------------------------------------------------------------
; CountReservedTables - counts rows whose first seat is occupied.
; Returns: EAX = number of reserved tables.
; ----------------------------------------------------------------------------
CountReservedTables PROC USES esi
    LOCAL count:DWORD, row:DWORD
    mov  count, 0
    mov  row, 0
CRT_Loop:
    mov  eax, row
    cmp  eax, TABLE_COUNT
    jae  CRT_Done
    shl  eax, 2                        ; row * 4  (SEATS_PER_TABLE)
    lea  esi, tableSeats
    cmp  BYTE PTR [esi+eax], 0
    je   CRT_Next
    inc  count
CRT_Next:
    inc  row
    jmp  CRT_Loop
CRT_Done:
    mov  eax, count
    ret
CountReservedTables ENDP

; ----------------------------------------------------------------------------
; CountActiveOrders - counts tables that have at least one order line.
; Returns: EAX = number of tables with orders.
; ----------------------------------------------------------------------------
CountActiveOrders PROC USES esi
    LOCAL count:DWORD, idx:DWORD
    mov  count, 0
    mov  idx, 0
CAO_Loop:
    mov  eax, idx
    cmp  eax, TABLE_COUNT
    jae  CAO_Done
    lea  esi, orderLineCount
    cmp  DWORD PTR [esi+eax*4], 0
    je   CAO_Next
    inc  count
CAO_Next:
    inc  idx
    jmp  CAO_Loop
CAO_Done:
    mov  eax, count
    ret
CountActiveOrders ENDP

; ----------------------------------------------------------------------------
; ShowTablesWithOrders - prints the numbers of tables that have order lines.
; Used on the order-table and bill-table selection screens.
; ----------------------------------------------------------------------------
ShowTablesWithOrders PROC USES esi ebx
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgTablesWithOrders
    call WriteString
    xor  ebx, ebx
STWO_Loop:
    cmp  ebx, TABLE_COUNT
    jae  STWO_Done
    lea  esi, orderLineCount
    cmp  DWORD PTR [esi+ebx*4], 0
    je   STWO_Next
    mov  eax, ebx
    inc  eax
    call WriteDec
    mov  al, ' '
    call WriteChar
STWO_Next:
    inc  ebx
    jmp  STWO_Loop
STWO_Done:
    call Crlf
    mov  eax, COLOR_NORMAL
    call SetTextColor
    ret
ShowTablesWithOrders ENDP

; ----------------------------------------------------------------------------
; WritePadded - writes a null-terminated string then pads with spaces.
; Receives: pString, fieldWidth.  If the string is longer, nothing is padded.
; ----------------------------------------------------------------------------
WritePadded PROC pString:PTR BYTE, fieldWidth:DWORD
    LOCAL len:DWORD, pad:DWORD
    INVOKE Str_length, pString
    mov  len, eax
    mov  edx, pString
    call WriteString

    mov  eax, fieldWidth
    sub  eax, len
    jbe  WP_Done                       ; fieldWidth <= length
    mov  pad, eax
WP_Spaces:
    mov  al, ' '
    call WriteChar
    dec  pad
    jnz  WP_Spaces
WP_Done:
    ret
WritePadded ENDP

; ----------------------------------------------------------------------------
; WriteDecPadded - writes an unsigned decimal right-aligned in a field.
; Receives: value, fieldWidth.
; ----------------------------------------------------------------------------
WriteDecPadded PROC USES ebx, value:DWORD, fieldWidth:DWORD
    LOCAL digits:DWORD, pad:DWORD, val:DWORD
    mov  eax, value
    mov  val, eax
    mov  digits, 1
    cmp  eax, 10
    jb   WDP_Print
    mov  ebx, 10
WDP_Count:
    xor  edx, edx
    div  ebx
    inc  digits
    cmp  eax, 10
    jae  WDP_Count
WDP_Print:
    mov  eax, fieldWidth
    sub  eax, digits
    jbe  WDP_Value
    mov  pad, eax
WDP_Spaces:
    mov  al, ' '
    call WriteChar
    dec  pad
    jnz  WDP_Spaces
WDP_Value:
    mov  eax, val
    call WriteDec
    ret
WriteDecPadded ENDP

; ----------------------------------------------------------------------------
; ClearScreen - clears only the visible console window.
; Irvine32's Clrscr writes blanks to every line of the console buffer.  The
; default Windows console buffer is 9001 lines, which makes Clrscr take several
; seconds.  This routine clears just the visible window (about 30 lines) and
; homes the cursor, so every menu redraw is instant.
; ----------------------------------------------------------------------------
ClearScreen PROC USES edi ebx
    LOCAL info:CONSOLE_SCREEN_BUFFER_INFO
    LOCAL origin:COORD
    LOCAL written:DWORD
    LOCAL fieldWidth:DWORD
    LOCAL row:DWORD

    INVOKE GetStdHandle, STD_OUTPUT_HANDLE
    mov  ebx, eax
    INVOKE GetConsoleScreenBufferInfo, ebx, ADDR info

    ; width = visible window width, capped at MAX_CLEAR_COLS
    movzx eax, info.srWindow.Right
    movzx ecx, info.srWindow.Left
    sub  eax, ecx
    inc  eax
    cmp  eax, MAX_CLEAR_COLS
    jbe  CS_WidthOK
    mov  eax, MAX_CLEAR_COLS
CS_WidthOK:
    mov  fieldWidth, eax

    ; Fill the attribute buffer with the current console attribute.
    mov  ax, info.wAttributes
    mov  ecx, fieldWidth
    mov  edi, OFFSET clearAttribs
    rep  stosw

    ; Clear each visible row.
    mov  origin.X, 0
    movzx eax, info.srWindow.Top
    mov  row, eax
CS_Row:
    mov  eax, row
    movzx ecx, info.srWindow.Bottom
    cmp  eax, ecx
    ja   CS_Done
    mov  origin.Y, ax
    INVOKE WriteConsoleOutputCharacter, ebx, ADDR clearBlanks, fieldWidth, origin, ADDR written
    INVOKE WriteConsoleOutputAttribute, ebx, ADDR clearAttribs, fieldWidth, origin, ADDR written
    inc  row
    jmp  CS_Row

CS_Done:
    mov  origin.X, 0
    movzx eax, info.srWindow.Top
    mov  origin.Y, ax
    INVOKE SetConsoleCursorPosition, ebx, origin
    ret
ClearScreen ENDP

; ----------------------------------------------------------------------------
; WaitEnter - replacement for Irvine32 WaitMsg.
; WaitMsg uses ReadChar, and ReadChar's ReadKey flushes the console input
; buffer after every poll.  A key that arrives just before a flush is lost.
; This routine uses ReadKeyWait, which never flushes, so a key press is never
; dropped.  The prompt text matches WaitMsg exactly.
; ----------------------------------------------------------------------------
WaitEnter PROC
    mov  edx, OFFSET msgPressAnyKey
    call WriteString
    call ReadKeyWait
    call Crlf
    ret
WaitEnter ENDP

; ----------------------------------------------------------------------------
; ViewMenu - proposal module 3.
; Displays item names, prices and stock.  Names are reached indirectly
; through menuNames, while prices/stock are parallel DWORD arrays.
; ----------------------------------------------------------------------------
ViewMenu PROC
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET menuTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    call PrintMenuTable

    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET menuFooter
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret
ViewMenu ENDP

; ----------------------------------------------------------------------------
; PrintMenuTable - prints the menu rows (no clearing, no pause).
; ----------------------------------------------------------------------------
PrintMenuTable PROC USES esi
    LOCAL i:DWORD
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET menuTableHeader
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  i, 0
PMT_Loop:
    mov  eax, i
    cmp  eax, MAX_ITEMS
    jae  PMT_Done

    inc  eax                           ; display item number as 1..10
    INVOKE WriteDecPadded, eax, 3
    mov  edx, OFFSET colSep
    call WriteString

    mov  eax, i
    lea  esi, menuNames                ; parallel pointer array
    mov  edx, DWORD PTR [esi+eax*4]    ; indirect: name address
    INVOKE WritePadded, edx, 24

    mov  eax, i
    lea  esi, menuPrices
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 9

    mov  eax, i
    lea  esi, menuStock
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 7
    call Crlf

    inc  i
    jmp  PMT_Loop
PMT_Done:
    mov  edx, OFFSET menuDivider
    call WriteString
    ret
PrintMenuTable ENDP

; ----------------------------------------------------------------------------
; DrawTableGrid - proposal module 4 (display side).
; Walks the 8 x 4 two-dimensional array with nested loops.  Offset is
; computed as row * SEATS_PER_TABLE + column, the standard row-major form.
; ----------------------------------------------------------------------------
DrawTableGrid PROC USES esi
    LOCAL row:DWORD, col:DWORD
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET tableGridHeader
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  row, 0
DT_Row:
    mov  eax, row
    cmp  eax, TABLE_COUNT
    jae  DT_Done

    inc  eax
    INVOKE WriteDecPadded, eax, 4
    mov  edx, OFFSET gridBar
    call WriteString

    mov  col, 0
DT_Col:
    mov  eax, col
    cmp  eax, SEATS_PER_TABLE
    jae  DT_Status

    mov  eax, row
    shl  eax, 2                        ; row * 4
    add  eax, col                      ; + column
    lea  esi, tableSeats
    movzx eax, BYTE PTR [esi+eax]
    test eax, eax
    jz   DT_FreeSeat
    mov  al, 'X'
    jmp  DT_PrintSeat
DT_FreeSeat:
    mov  al, '.'
DT_PrintSeat:
    call WriteChar
    mov  al, ' '
    call WriteChar
    inc  col
    jmp  DT_Col

DT_Status:
    mov  edx, OFFSET gridBar
    call WriteString
    mov  eax, row
    shl  eax, 2
    lea  esi, tableSeats
    cmp  BYTE PTR [esi+eax], 0
    je   DT_Available

    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET statusReserved
    call WriteString
    mov  eax, row
    lea  esi, tableParty
    movzx eax, BYTE PTR [esi+eax]
    call WriteDec
    mov  edx, OFFSET statusGuests
    call WriteString
    jmp  DT_Reset

DT_Available:
    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET statusAvailable
    call WriteString

DT_Reset:
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call Crlf
    inc  row
    jmp  DT_Row

DT_Done:
    mov  edx, OFFSET gridLegend
    call WriteString
    ret
DrawTableGrid ENDP

; ----------------------------------------------------------------------------
; ReserveTable - proposal module 4 (reservation side).
; Reads a table number and party size, checks availability through the 2-D
; array, then marks every seat in that row occupied with REP STOSB.
; ----------------------------------------------------------------------------
ReserveTable PROC USES esi edi ebx
    LOCAL tableNo:DWORD, row:DWORD, party:DWORD, freeCount:DWORD

    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET tableTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call DrawTableGrid

    ; Count free tables; refuse early if the restaurant is full.
    call CountReservedTables
    mov  ebx, TABLE_COUNT
    sub  ebx, eax
    mov  freeCount, ebx
    test ebx, ebx
    jnz  RT_Prompt

    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgAllReserved
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

RT_Prompt:
    mov  edx, OFFSET promptTableNo
    call WriteString
    call ReadNumber
    jc   RT_BadTable
    test eax, eax
    jz   RT_Cancelled
    cmp  eax, 1
    jb   RT_BadTable
    cmp  eax, TABLE_COUNT
    ja   RT_BadTable

    mov  tableNo, eax
    dec  eax
    mov  row, eax
    shl  eax, 2
    lea  esi, tableSeats
    cmp  BYTE PTR [esi+eax], 0
    jne  RT_Occupied

RT_Party:
    mov  edx, OFFSET promptParty
    call WriteString
    call ReadNumber
    jc   RT_BadParty
    test eax, eax
    jz   RT_Cancelled
    cmp  eax, 1
    jb   RT_BadParty
    cmp  eax, SEATS_PER_TABLE
    ja   RT_BadParty
    mov  party, eax

    ; Mark the whole row occupied (a table is reserved exclusively).
    mov  eax, row
    shl  eax, 2
    lea  edi, tableSeats
    add  edi, eax
    mov  ecx, SEATS_PER_TABLE
    mov  al, 1
    rep  stosb

    ; Store the party size separately for display and the receipt.
    mov  eax, row
    lea  esi, tableParty
    mov  edx, party
    mov  BYTE PTR [esi+eax], dl

    call ClearScreen
    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgReservedOK
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  edx, OFFSET msgTableLabel
    call WriteString
    mov  eax, tableNo
    call WriteDec
    mov  edx, OFFSET msgForLabel
    call WriteString
    mov  eax, party
    call WriteDec
    mov  edx, OFFSET msgGuestsLabel
    call WriteString
    call Crlf
    call DrawTableGrid
    call WaitEnter
    ret

RT_BadTable:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidTable
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  RT_Prompt

RT_Occupied:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgTableOccupied
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  RT_Prompt

RT_BadParty:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidParty
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  RT_Party

RT_Cancelled:
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgReservationCancelled
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret
ReserveTable ENDP

; ----------------------------------------------------------------------------
; FindOrderLine - searches one table's order for a menu item.
; Receives: tableIdx (0-based), itemIndex.
; Returns:  EAX = line index within that table's order, or -1 if not present.
; ----------------------------------------------------------------------------
FindOrderLine PROC USES esi edx ecx, tableIdx:DWORD, itemIndex:DWORD
    mov  edx, itemIndex
    mov  eax, tableIdx
    lea  esi, orderLineCount
    mov  ecx, DWORD PTR [esi+eax*4]    ; this table's line count
    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2                        ; byte offset of this table's block
    lea  esi, orderItem
    add  esi, eax
    xor  eax, eax
FOL_Loop:
    cmp  eax, ecx
    jae  FOL_NotFound
    cmp  DWORD PTR [esi+eax*4], edx
    je   FOL_Done
    inc  eax
    jmp  FOL_Loop
FOL_NotFound:
    mov  eax, -1
FOL_Done:
    ret
FindOrderLine ENDP

; ----------------------------------------------------------------------------
; TakeOrder - proposal module 5 (per-table version).
; Prompts for a reserved table and maintains that table's own order lines,
; line count and subtotal.  Item numbers and quantities are validated against
; stock, stock is decremented immediately, and the subtotal is accumulated
; with MUL plus extended addition (ADD/ADC).  Entering 0 finishes ordering for
; the selected table only; other tables keep their orders untouched.
; ----------------------------------------------------------------------------
TakeOrder PROC USES esi edi ebx
    LOCAL tableNo:DWORD, tableIdx:DWORD, itemIdx:DWORD, availStock:DWORD
    LOCAL qty:DWORD, lineTotal:DWORD, lineBase:DWORD, lineCount:DWORD

    ; A table must be reserved before an order can be taken.
    call CountReservedTables
    test eax, eax
    jnz  TO_SelectTable

    call ClearScreen
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgNoReservedTables
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

TO_SelectTable:
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET orderTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  edx, OFFSET msgSelectTable
    call WriteString
    call DrawTableGrid
    call ShowTablesWithOrders

TO_TablePrompt:
    mov  edx, OFFSET promptOrderTable
    call WriteString
    call ReadNumber
    jc   TO_BadTable
    test eax, eax
    jz   TO_Cancel
    cmp  eax, 1
    jb   TO_BadTable
    cmp  eax, TABLE_COUNT
    ja   TO_BadTable

    mov  tableNo, eax
    dec  eax
    mov  tableIdx, eax
    shl  eax, 2
    lea  esi, tableSeats
    cmp  BYTE PTR [esi+eax], 0
    je   TO_TableNotReserved
    jmp  TO_OrderLoop

TO_BadTable:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidTable
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  TO_TablePrompt

TO_TableNotReserved:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgTableNotReserved
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  TO_TablePrompt

TO_Cancel:
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgOrderCancelled
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

; ---------------------------- Order entry loop -----------------------------
TO_OrderLoop:
    ; Load this table's line count and the byte offset of its line block.
    mov  eax, tableIdx
    lea  esi, orderLineCount
    mov  eax, DWORD PTR [esi+eax*4]
    mov  lineCount, eax
    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    mov  lineBase, eax

    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET orderTitle
    call WriteString
    mov  edx, OFFSET msgOrderForTable
    call WriteString
    mov  eax, tableNo
    call WriteDec
    call Crlf
    mov  eax, COLOR_NORMAL
    call SetTextColor

    call PrintMenuTable

    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgItemsCount
    call WriteString
    mov  eax, lineCount
    call WriteDec
    mov  edx, OFFSET msgRunning
    call WriteString
    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  eax, DWORD PTR [esi+eax*4]
    call WriteDec
    call Crlf
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET promptItem
    call WriteString
    call ReadNumber
    jc   TO_BadItem
    test eax, eax
    jz   TO_Finish
    cmp  eax, 1
    jb   TO_BadItem
    cmp  eax, MAX_ITEMS
    ja   TO_BadItem
    dec  eax
    mov  itemIdx, eax

    ; Stock check (menuStock is a parallel array).
    lea  esi, menuStock
    mov  eax, DWORD PTR [esi+eax*4]
    test eax, eax
    jz   TO_OutOfStock
    mov  availStock, eax

    ; Read the quantity and validate it against the remaining stock.
    mov  edx, OFFSET promptQty1
    call WriteString
    mov  eax, availStock
    call WriteDec
    mov  edx, OFFSET promptQty2
    call WriteString
    call ReadNumber
    jc   TO_BadQty
    test eax, eax
    jz   TO_OrderLoop                  ; 0 = skip this item
    cmp  eax, 1
    jb   TO_BadQty
    cmp  eax, availStock
    ja   TO_BadQty
    mov  qty, eax

    ; If the item is already on this table's order, combine the quantities.
    INVOKE FindOrderLine, tableIdx, itemIdx
    cmp  eax, -1
    je   TO_NewLine
    mov  ecx, lineBase
    lea  esi, orderQty
    add  esi, ecx
    mov  edx, qty
    add  DWORD PTR [esi+eax*4], edx
    jmp  TO_UpdateStock

TO_NewLine:
    mov  eax, lineCount
    cmp  eax, MAX_ORDER_LINES
    jae  TO_OrderFull
    mov  ecx, lineBase
    lea  esi, orderItem
    add  esi, ecx
    mov  edx, itemIdx
    mov  DWORD PTR [esi+eax*4], edx
    lea  esi, orderQty
    add  esi, ecx
    mov  edx, qty
    mov  DWORD PTR [esi+eax*4], edx
    mov  ecx, tableIdx
    lea  esi, orderLineCount
    inc  DWORD PTR [esi+ecx*4]

TO_UpdateStock:
    ; Decrement inventory immediately (proposal: update quantity).
    mov  eax, itemIdx
    lea  esi, menuStock
    mov  edx, qty
    sub  DWORD PTR [esi+eax*4], edx

    ; Line total = price * quantity, then add to this table's 64-bit subtotal.
    mov  eax, itemIdx
    lea  esi, menuPrices
    mov  eax, DWORD PTR [esi+eax*4]
    mov  ecx, qty
    mul  ecx                           ; EDX:EAX = price * qty
    mov  lineTotal, eax
    mov  ebx, edx                      ; high word for ADC
    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  ecx, lineTotal
    add  DWORD PTR [esi+eax*4], ecx    ; extended addition: low + carry
    lea  esi, orderSubtotalHi
    adc  DWORD PTR [esi+eax*4], ebx

    ; Feedback for the added item.
    mov  edx, OFFSET msgAdded
    call WriteString
    mov  eax, itemIdx
    lea  esi, menuNames
    mov  edx, DWORD PTR [esi+eax*4]
    call WriteString
    mov  edx, OFFSET msgTimes
    call WriteString
    mov  eax, qty
    call WriteDec
    mov  edx, OFFSET msgEquals
    call WriteString
    mov  eax, lineTotal
    call WriteDec
    call Crlf

    mov  edx, OFFSET msgRunning
    call WriteString
    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  eax, DWORD PTR [esi+eax*4]
    call WriteDec
    call Crlf
    call WaitEnter
    jmp  TO_OrderLoop

TO_BadItem:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidItem
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  TO_OrderLoop

TO_OutOfStock:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgOutOfStock
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  TO_OrderLoop

TO_BadQty:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidQty
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  TO_OrderLoop

TO_OrderFull:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgOrderFull
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  TO_OrderLoop

; ---------------------------- Finish ordering ------------------------------
TO_Finish:
    ; Only this table's line count is inspected.
    mov  eax, tableIdx
    lea  esi, orderLineCount
    cmp  DWORD PTR [esi+eax*4], 0
    jne  TO_FinishWithItems

    ; Empty order: nothing was added; the table stays reserved.
    call ClearScreen
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgOrderEmpty
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

TO_FinishWithItems:
    call ClearScreen
    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgOrderRecorded
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call Crlf
    mov  edx, OFFSET msgOrderForTable
    call WriteString
    mov  eax, tableNo
    call WriteDec
    call Crlf
    mov  edx, OFFSET msgRunning
    call WriteString
    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  eax, DWORD PTR [esi+eax*4]
    call WriteDec
    call Crlf
    call WaitEnter
    ret
TakeOrder ENDP

; ----------------------------------------------------------------------------
; ComputeBill - proposal module 6 (per-table version).
; Receives: tableIdx (0-based).
; Publishes:
;   billSubtotal, billTax, billDiscount, billFinal, billPoints.
;   - Tax:      subtotal * TAX_PERCENT / 100   (MUL then DIV)
;   - Discount: subtotal >> 2 when >= 3000     (SHR = 25% promo)
;   - Final:    subtotal + tax - discount
;   - Points:   recursive CalcLoyaltyPoints
; The subtotal read here belongs only to the requested table and was
; accumulated with ADD/ADC (extended addition).
; ----------------------------------------------------------------------------
ComputeBill PROC USES ebx esi, tableIdx:DWORD
    LOCAL subtotal:DWORD, taxAmt:DWORD, discountAmt:DWORD
    LOCAL finalAmt:DWORD, points:DWORD

    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  eax, DWORD PTR [esi+eax*4]
    mov  subtotal, eax

    ; tax = subtotal * 5 / 100
    mov  eax, subtotal
    mov  ebx, TAX_PERCENT
    mul  ebx                           ; EDX:EAX = subtotal * 5
    mov  ecx, 100
    div  ecx                           ; EAX = quotient (tax)
    mov  taxAmt, eax

    ; 25% promotional discount using a bit shift (SHR by 2).
    mov  discountAmt, 0
    mov  eax, subtotal
    cmp  eax, DISC_THRESHOLD
    jb   CB_NoDiscount
    shr  eax, 2
    mov  discountAmt, eax
CB_NoDiscount:

    ; final = subtotal + tax - discount
    mov  eax, subtotal
    add  eax, taxAmt
    sub  eax, discountAmt
    mov  finalAmt, eax

    ; Recursive loyalty points: one point per complete Rs. 100.
    INVOKE CalcLoyaltyPoints, subtotal
    mov  points, eax

    ; Publish results for the receipt.
    mov  eax, subtotal
    mov  billSubtotal, eax
    mov  eax, taxAmt
    mov  billTax, eax
    mov  eax, discountAmt
    mov  billDiscount, eax
    mov  eax, finalAmt
    mov  billFinal, eax
    mov  eax, points
    mov  billPoints, eax
    ret
ComputeBill ENDP

; ----------------------------------------------------------------------------
; CalcLoyaltyPoints - recursive loyalty calculation (proposal module 7).
; Receives: total (DWORD).  Returns: EAX = total / 100, computed as
;   0                         if total < 100
;   1 + CalcLoyaltyPoints(total - 100)   otherwise
; A stack frame and a recursive INVOKE are used deliberately.
; ----------------------------------------------------------------------------
CalcLoyaltyPoints PROC total:DWORD
    mov  eax, total

    cmp  eax, POINTS_UNIT
    jb   CLP_Zero

    sub  eax, POINTS_UNIT
    INVOKE CalcLoyaltyPoints, eax      ; recursive call
    inc  eax
    ret

CLP_Zero:
    xor  eax, eax
    ret
CalcLoyaltyPoints ENDP

; ----------------------------------------------------------------------------
; PrintReceipt - proposal module 7 (formatting side).
; Receives: tableIdx (0-based).  Prints that table's order lines, then
; subtotal, discount, tax, final balance and loyalty points.  ComputeBill
; publishes the totals for the same table.
; ----------------------------------------------------------------------------
PrintReceipt PROC USES esi edi, tableIdx:DWORD
    LOCAL i:DWORD, itemIdx:DWORD, qty:DWORD, price:DWORD, lineTotal:DWORD
    LOCAL lineBase:DWORD, lineCount:DWORD

    INVOKE ComputeBill, tableIdx
    call ClearScreen

    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET receiptBanner
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    ; Receipt number, table and party size for the selected table.
    mov  edx, OFFSET metaReceipt
    call WriteString
    mov  eax, receiptNo
    call WriteDec
    mov  edx, OFFSET metaTable
    call WriteString
    mov  eax, tableIdx
    inc  eax
    call WriteDec
    mov  eax, tableIdx
    lea  esi, tableParty
    movzx eax, BYTE PTR [esi+eax]
    mov  edx, OFFSET metaGuests
    call WriteString
    call WriteDec
    call Crlf

    mov  edx, OFFSET receiptCols
    call WriteString
    mov  edx, OFFSET receiptDivider
    call WriteString

    ; Prepare this table's line count and line-block base offset.
    mov  eax, tableIdx
    lea  esi, orderLineCount
    mov  eax, DWORD PTR [esi+eax*4]
    mov  lineCount, eax
    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    mov  lineBase, eax

    ; Itemised lines.
    mov  i, 0
PR_Loop:
    mov  eax, i
    cmp  eax, lineCount
    jae  PR_LinesDone

    mov  ecx, lineBase
    lea  esi, orderItem
    add  esi, ecx
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    mov  itemIdx, eax

    lea  esi, menuNames
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WritePadded, edx, 24

    mov  ecx, lineBase
    lea  esi, orderQty
    add  esi, ecx
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    mov  qty, eax
    INVOKE WriteDecPadded, eax, 4

    mov  eax, itemIdx
    lea  esi, menuPrices
    mov  eax, DWORD PTR [esi+eax*4]
    mov  price, eax
    INVOKE WriteDecPadded, eax, 10

    mov  eax, price
    mov  ecx, qty
    mul  ecx
    mov  lineTotal, eax
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    inc  i
    jmp  PR_Loop

PR_LinesDone:
    mov  edx, OFFSET receiptDivider
    call WriteString

    ; Subtotal.
    mov  edx, OFFSET lblSubtotal
    INVOKE WritePadded, edx, 44
    mov  eax, billSubtotal
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    ; Discount (promo or not applicable).
    cmp  billDiscount, 0
    jne  PR_DiscountPromo
    mov  edx, OFFSET lblDiscountNone
    jmp  PR_DiscountLabel
PR_DiscountPromo:
    mov  edx, OFFSET lblDiscountPromo
PR_DiscountLabel:
    INVOKE WritePadded, edx, 44
    mov  eax, billDiscount
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    ; Tax.
    mov  edx, OFFSET lblTax
    INVOKE WritePadded, edx, 44
    mov  eax, billTax
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    mov  edx, OFFSET receiptDivider
    call WriteString

    ; Final balance, highlighted.
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET lblFinal
    INVOKE WritePadded, edx, 44
    mov  eax, billFinal
    INVOKE WriteDecPadded, eax, 12
    call Crlf
    mov  eax, COLOR_NORMAL
    call SetTextColor

    ; Loyalty points.
    mov  edx, OFFSET lblPoints
    INVOKE WritePadded, edx, 44
    mov  eax, billPoints
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    mov  edx, OFFSET receiptFooter
    call WriteString
    mov  edx, OFFSET msgThankYou
    call WriteString
    ret
PrintReceipt ENDP

; ----------------------------------------------------------------------------
; GenerateReceipt - per-table billing.
; The administrator chooses the table to bill.  Only that table's order is
; printed, filed and finalized, so other tables keep their orders and
; reservations.  Receipt numbers are issued per bill.
; ----------------------------------------------------------------------------
GenerateReceipt PROC USES esi ebx
    LOCAL tableNo:DWORD, tableIdx:DWORD

    ; Nothing to bill if no table has an order.
    call CountActiveOrders
    test eax, eax
    jz   GR_None

    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET billTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  edx, OFFSET msgSelectBillTable
    call WriteString
    call DrawTableGrid
    call ShowTablesWithOrders

GR_Prompt:
    mov  edx, OFFSET promptBillTable
    call WriteString
    call ReadNumber
    jc   GR_BadTable
    test eax, eax
    jz   GR_Cancel
    cmp  eax, 1
    jb   GR_BadTable
    cmp  eax, TABLE_COUNT
    ja   GR_BadTable

    mov  tableNo, eax
    dec  eax
    mov  tableIdx, eax

    ; Billing requires an order for this table.  Reservation alone is not
    ; enough: a reserved table with no order lines cannot be billed.
    lea  esi, orderLineCount
    mov  eax, tableIdx
    cmp  DWORD PTR [esi+eax*4], 0
    je   GR_NoOrder

    INVOKE PrintReceipt, tableIdx
    INVOKE AppendReceiptToFile, tableIdx
    call WaitEnter
    INVOKE FinalizeOrder, tableIdx
    ret

GR_BadTable:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidTable
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  GR_Prompt

GR_NoOrder:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgTableNoOrder
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  GR_Prompt

GR_Cancel:
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgBillingCancelled
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

GR_None:
    call ClearScreen
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgNoActiveOrder
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret
GenerateReceipt ENDP

; ----------------------------------------------------------------------------
; FinalizeOrder - releases one table after its bill is paid.
; Receives: tableIdx (0-based).  Frees that table's seats, clears that
; table's party size, order lines, line count and subtotal, and advances the
; receipt number.  Other tables are not touched.  Stock remains reduced.
; ----------------------------------------------------------------------------
FinalizeOrder PROC USES esi edi ebx, tableIdx:DWORD
    ; Free the selected table's row in the 2-D seat array.
    mov  eax, tableIdx
    shl  eax, 2
    lea  edi, tableSeats
    add  edi, eax
    mov  ecx, SEATS_PER_TABLE
    xor  eax, eax
    rep  stosb

    ; Clear the party size for this table only.
    mov  eax, tableIdx
    lea  esi, tableParty
    mov  BYTE PTR [esi+eax], 0

    ; Clear this table's line count and 64-bit subtotal.
    lea  esi, orderLineCount
    mov  DWORD PTR [esi+eax*4], 0
    lea  esi, orderSubtotalLo
    mov  DWORD PTR [esi+eax*4], 0
    lea  esi, orderSubtotalHi
    mov  DWORD PTR [esi+eax*4], 0

    ; Wipe this table's order storage so no stale lines survive.
    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    lea  edi, orderItem
    add  edi, eax
    mov  ecx, MAX_ORDER_LINES
    xor  eax, eax
    rep  stosd

    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    lea  edi, orderQty
    add  edi, eax
    mov  ecx, MAX_ORDER_LINES
    xor  eax, eax
    rep  stosd

    inc  receiptNo
    ret
FinalizeOrder ENDP

; ----------------------------------------------------------------------------
; UIntToStr - converts an unsigned 32-bit value to a null-terminated string.
; Receives: value, pBuffer.  Returns: EAX = number of characters written.
; ----------------------------------------------------------------------------
UIntToStr PROC USES ebx ecx edx edi, value:DWORD, pBuffer:PTR BYTE
    mov  eax, value
    mov  edi, pBuffer
    cmp  eax, 0
    jne  UTS_NonZero
    mov  BYTE PTR [edi], '0'
    mov  BYTE PTR [edi+1], 0
    mov  eax, 1
    ret

UTS_NonZero:
    xor  ecx, ecx                      ; digit count
    mov  ebx, 10
UTS_DivLoop:
    xor  edx, edx
    div  ebx                           ; EAX = quotient, EDX = remainder
    push edx
    inc  ecx
    test eax, eax
    jnz  UTS_DivLoop

    mov  eax, ecx                      ; return length
UTS_StoreLoop:
    pop  edx
    add  dl, '0'
    mov  BYTE PTR [edi], dl
    inc  edi
    dec  ecx
    jnz  UTS_StoreLoop
    mov  BYTE PTR [edi], 0
    ret
UIntToStr ENDP

; ----------------------------------------------------------------------------
; WriteStrToFile - writes a null-terminated string to an open file handle.
; Receives: hFile, pString.
; ----------------------------------------------------------------------------
WriteStrToFile PROC USES eax ecx edx, hFile:DWORD, pString:PTR BYTE
    LOCAL bytesWritten:DWORD
    INVOKE Str_length, pString
    mov  ecx, eax
    jecxz WSTF_Done
    INVOKE WriteFile, hFile, pString, ecx, ADDR bytesWritten, NULL
WSTF_Done:
    ret
WriteStrToFile ENDP

; ----------------------------------------------------------------------------
; WriteDecToFile - writes an unsigned decimal value to an open file handle.
; Receives: hFile, value.
; ----------------------------------------------------------------------------
WriteDecToFile PROC USES eax, hFile:DWORD, value:DWORD
    INVOKE UIntToStr, value, ADDR numStrBuffer
    INVOKE WriteStrToFile, hFile, ADDR numStrBuffer
    ret
WriteDecToFile ENDP

; ----------------------------------------------------------------------------
; AppendReceiptToFile - filing feature.
; Receives: tableIdx (0-based).  Appends a formatted record for that table's
; current receipt to records.txt.  Called after PrintReceipt (bill totals
; computed) and before FinalizeOrder.
; ----------------------------------------------------------------------------
AppendReceiptToFile PROC USES eax ebx ecx edx esi edi, tableIdx:DWORD
    LOCAL hFile:DWORD
    LOCAL i:DWORD
    LOCAL itemIdx:DWORD
    LOCAL qty:DWORD
    LOCAL lineTotal:DWORD
    LOCAL guestCount:DWORD
    LOCAL tableNo:DWORD
    LOCAL lineBase:DWORD
    LOCAL lineCount:DWORD

    INVOKE CreateFile, ADDR recordsFileName, GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL
    cmp  eax, INVALID_HANDLE_VALUE
    je   ARF_Error
    mov  hFile, eax

    ; Move to end of file for append.
    INVOKE SetFilePointer, hFile, 0, NULL, FILE_END

    ; Header
    INVOKE WriteStrToFile, hFile, ADDR fileRecSep
    INVOKE WriteStrToFile, hFile, ADDR fileRecTitle
    INVOKE WriteDecToFile, hFile, receiptNo
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    ; Table and guests (only the selected table's data is written).
    mov  eax, tableIdx
    inc  eax
    mov  tableNo, eax
    INVOKE WriteStrToFile, hFile, ADDR fileRecTable
    INVOKE WriteDecToFile, hFile, tableNo
    INVOKE WriteStrToFile, hFile, ADDR fileRecGuests
    mov  eax, tableIdx
    lea  esi, tableParty
    movzx eax, BYTE PTR [esi+eax]
    mov  guestCount, eax
    INVOKE WriteDecToFile, hFile, guestCount
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    ; Prepare this table's line count and line-block base offset.
    mov  eax, tableIdx
    lea  esi, orderLineCount
    mov  eax, DWORD PTR [esi+eax*4]
    mov  lineCount, eax
    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    mov  lineBase, eax

    ; Item lines
    mov  i, 0
ARF_ItemLoop:
    mov  eax, i
    cmp  eax, lineCount
    jae  ARF_ItemsDone

    mov  ecx, lineBase
    lea  esi, orderItem
    add  esi, ecx
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    mov  itemIdx, eax

    mov  ecx, lineBase
    lea  esi, orderQty
    add  esi, ecx
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    mov  qty, eax

    INVOKE WriteStrToFile, hFile, ADDR fileItemSep
    mov  eax, itemIdx
    lea  esi, menuNames
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WriteStrToFile, hFile, edx
    INVOKE WriteStrToFile, hFile, ADDR fileQtySep
    INVOKE WriteDecToFile, hFile, qty

    mov  eax, itemIdx
    lea  esi, menuPrices
    mov  eax, DWORD PTR [esi+eax*4]
    mov  ecx, qty
    mul  ecx
    mov  lineTotal, eax
    INVOKE WriteStrToFile, hFile, ADDR fileLineSep
    INVOKE WriteDecToFile, hFile, lineTotal
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    inc  i
    jmp  ARF_ItemLoop

ARF_ItemsDone:
    ; Totals
    INVOKE WriteStrToFile, hFile, ADDR fileRecItems
    INVOKE WriteDecToFile, hFile, lineCount
    INVOKE WriteStrToFile, hFile, ADDR fileRecSubtotal
    INVOKE WriteDecToFile, hFile, billSubtotal
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    INVOKE WriteStrToFile, hFile, ADDR fileRecTax
    INVOKE WriteDecToFile, hFile, billTax
    INVOKE WriteStrToFile, hFile, ADDR fileRecDiscount
    INVOKE WriteDecToFile, hFile, billDiscount
    INVOKE WriteStrToFile, hFile, ADDR fileNewLine

    INVOKE WriteStrToFile, hFile, ADDR fileRecFinal
    INVOKE WriteDecToFile, hFile, billFinal
    INVOKE WriteStrToFile, hFile, ADDR fileRecPoints
    INVOKE WriteDecToFile, hFile, billPoints
    INVOKE WriteStrToFile, hFile, ADDR fileBlankLine

    INVOKE CloseHandle, hFile
    ret

ARF_Error:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgFileWriteErr
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    ret
AppendReceiptToFile ENDP

; ----------------------------------------------------------------------------
; ViewFiledRecords - filing feature.
; Opens records.txt and displays its contents on screen.
; ----------------------------------------------------------------------------
ViewFiledRecords PROC USES eax ebx ecx edx esi edi
    LOCAL hFile:DWORD
    LOCAL bytesRead:DWORD

    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET fileTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    INVOKE CreateFile, ADDR recordsFileName, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL
    cmp  eax, INVALID_HANDLE_VALUE
    je   VFR_NoFile
    mov  hFile, eax

VFR_ReadLoop:
    INVOKE ReadFile, hFile, ADDR fileBuffer, FILE_BUF_SIZE - 1, ADDR bytesRead, NULL
    cmp  bytesRead, 0
    je   VFR_Done
    mov  eax, bytesRead
    lea  edi, fileBuffer
    mov  BYTE PTR [edi+eax], 0
    mov  edx, OFFSET fileBuffer
    call WriteString
    jmp  VFR_ReadLoop

VFR_Done:
    INVOKE CloseHandle, hFile
    call Crlf
    call WaitEnter
    ret

VFR_NoFile:
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgNoFile
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret
ViewFiledRecords ENDP

; ----------------------------------------------------------------------------
; ToLowerChar - returns lowercase ASCII character in AL.
; Receives: charVal (DWORD, low byte used).  Returns: EAX = lowercase char.
; (The parameter is NOT named "ch" because CH is an x86 register name.)
; ----------------------------------------------------------------------------
ToLowerChar PROC charVal:DWORD
    mov  eax, charVal
    cmp  al, 'A'
    jb   TLC_Done
    cmp  al, 'Z'
    ja   TLC_Done
    add  al, 32
TLC_Done:
    movzx eax, al
    ret
ToLowerChar ENDP

; ----------------------------------------------------------------------------
; StrContainsInsensitive - case-insensitive substring search.
; Receives: pHaystack, pNeedle.  Returns: EAX = 1 if found, 0 otherwise.
; ----------------------------------------------------------------------------
StrContainsInsensitive PROC USES ebx ecx edx esi edi, pHaystack:PTR BYTE, pNeedle:PTR BYTE
    LOCAL hLen:DWORD
    LOCAL nLen:DWORD
    LOCAL i:DWORD
    LOCAL j:DWORD

    INVOKE Str_length, pHaystack
    mov  hLen, eax
    INVOKE Str_length, pNeedle
    mov  nLen, eax

    cmp  nLen, 0
    je   SCI_Found                     ; empty needle matches
    mov  eax, hLen
    cmp  eax, nLen
    jb   SCI_NotFound

    mov  eax, hLen
    sub  eax, nLen
    mov  ecx, eax                      ; max start index
    mov  i, 0

SCI_Outer:
    mov  eax, i
    cmp  eax, ecx
    ja   SCI_NotFound

    mov  j, 0
SCI_Inner:
    mov  eax, j
    cmp  eax, nLen
    jae  SCI_Found

    mov  esi, pHaystack
    add  esi, i
    add  esi, j
    movzx ebx, BYTE PTR [esi]
    INVOKE ToLowerChar, bl
    mov  bl, al

    mov  edi, pNeedle
    add  edi, j
    movzx edx, BYTE PTR [edi]
    push ebx
    INVOKE ToLowerChar, dl
    pop  ebx
    cmp  bl, al
    jne  SCI_NextOuter

    inc  j
    jmp  SCI_Inner

SCI_NextOuter:
    inc  i
    jmp  SCI_Outer

SCI_Found:
    mov  eax, 1
    ret
SCI_NotFound:
    xor  eax, eax
    ret
StrContainsInsensitive ENDP

; ----------------------------------------------------------------------------
; SearchMenuItem - searching feature.
; Searches menu items by item number or by name (case-insensitive substring).
; ----------------------------------------------------------------------------
SearchMenuItem PROC USES esi edi ebx
    LOCAL choice:DWORD
    LOCAL itemNo:DWORD
    LOCAL i:DWORD
    LOCAL found:DWORD
    LOCAL inLen:DWORD
    LOCAL pNeedle:PTR BYTE

SM_Retry:
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET searchTitle
    call WriteString
    mov  eax, COLOR_MENU
    call SetTextColor
    mov  edx, OFFSET searchMenu
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET promptSearchMode
    call WriteString
    call ReadNumber
    jc   SM_BadMode
    mov  choice, eax
    cmp  eax, 0
    je   SM_Done
    cmp  eax, 1
    je   SM_ByNumber
    cmp  eax, 2
    je   SM_ByName
    jmp  SM_BadMode

SM_ByNumber:
    mov  edx, OFFSET promptSearchNum
    call WriteString
    call ReadNumber
    jc   SM_BadNum
    cmp  eax, 1
    jb   SM_BadNum
    cmp  eax, MAX_ITEMS
    ja   SM_BadNum
    mov  itemNo, eax

    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET msgSearchFound
    call WriteString
    mov  edx, OFFSET msgSearchHeader
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  eax, itemNo
    dec  eax
    mov  i, eax

    ; Print the single matching row
    mov  eax, i
    inc  eax
    INVOKE WriteDecPadded, eax, 3
    mov  edx, OFFSET colSep
    call WriteString
    lea  esi, menuNames
    mov  eax, i
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WritePadded, edx, 24
    lea  esi, menuPrices
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 9
    lea  esi, menuStock
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 7
    call Crlf
    mov  edx, OFFSET menuDivider
    call WriteString
    call WaitEnter
    ret

SM_ByName:
    mov  edx, OFFSET promptSearchName
    call WriteString
    mov  edx, OFFSET searchBuf
    mov  ecx, SEARCH_BUF_SIZE - 1
    call ReadString
    mov  inLen, eax
    test eax, eax
    jz   SM_EmptyName

    ; Trim leading spaces check: if all spaces, treat as empty
    lea  esi, searchBuf
SM_TrimCheck:
    mov  al, BYTE PTR [esi]
    cmp  al, 0
    je   SM_EmptyName
    cmp  al, ' '
    je   SM_TrimNext
    cmp  al, 9
    je   SM_TrimNext
    jmp  SM_DoSearch
SM_TrimNext:
    inc  esi
    jmp  SM_TrimCheck

SM_DoSearch:
    mov  pNeedle, esi
    mov  found, 0
    mov  i, 0

    ; Search all items
SM_SearchLoop:
    mov  eax, i
    cmp  eax, MAX_ITEMS
    jae  SM_SearchDone

    lea  esi, menuNames
    mov  eax, i
    mov  edx, DWORD PTR [esi+eax*4]    ; item name
    INVOKE StrContainsInsensitive, edx, pNeedle
    test eax, eax
    jz   SM_SearchNext

    ; First match: print header
    cmp  found, 0
    jne  SM_PrintMatch
    mov  found, 1
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET msgSearchFound
    call WriteString
    mov  edx, OFFSET msgSearchHeader
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

SM_PrintMatch:
    mov  eax, i
    inc  eax
    INVOKE WriteDecPadded, eax, 3
    mov  edx, OFFSET colSep
    call WriteString
    lea  esi, menuNames
    mov  eax, i
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WritePadded, edx, 24
    lea  esi, menuPrices
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 9
    lea  esi, menuStock
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 7
    call Crlf

SM_SearchNext:
    inc  i
    jmp  SM_SearchLoop

SM_SearchDone:
    cmp  found, 0
    je   SM_NoMatch
    mov  edx, OFFSET menuDivider
    call WriteString
    call WaitEnter
    ret

SM_NoMatch:
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgSearchNone
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

SM_BadMode:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgSearchInvalid
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  SM_Retry

SM_BadNum:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgSearchNumBad
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  SM_Retry

SM_EmptyName:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgSearchEmpty
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  SM_Retry

SM_Done:
    ret
SearchMenuItem ENDP

; ----------------------------------------------------------------------------
; Goodbye - final screen before ExitProcess.
; ----------------------------------------------------------------------------
Goodbye PROC
    call ClearScreen
    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgGoodbye
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  edx, OFFSET msgGroup
    call WriteString
    call WaitEnter
    ret
Goodbye ENDP

END main
