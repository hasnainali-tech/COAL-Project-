; ----------------------------------------------------------------------------
; AdminLogin - proposal module 1.
; Reads a username and a masked password and verifies both with CMPSB
; (inside VerifyString).  The login repeats until the credentials match.
; ----------------------------------------------------------------------------
AdminLogin PROC
LoginRetry:
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET loginBanner
    call WriteString

    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET loginHint
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET promptUser
    call WriteString
    mov  edx, OFFSET userBuf
    mov  ecx, 32
    call ReadString

    mov  edx, OFFSET promptPass
    call WriteString
    INVOKE ReadPassword, OFFSET passBuf, 32

    ; Verify the username with CMPSB.
    INVOKE Str_length, OFFSET userBuf  ; EAX = entered length
    INVOKE VerifyString, OFFSET adminUser, OFFSET userBuf, ADMIN_USER_LEN, eax
    test eax, eax
    jz   LoginFailed

    ; Verify the password with CMPSB.
    INVOKE Str_length, OFFSET passBuf
    INVOKE VerifyString, OFFSET adminPass, OFFSET passBuf, ADMIN_PASS_LEN, eax
    test eax, eax
    jz   LoginFailed

    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgLoginOK
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  eax, 800
    call Delay
    ret

LoginFailed:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgBadLogin
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  eax, 1200
    call Delay
    jmp  LoginRetry
AdminLogin ENDP

; ----------------------------------------------------------------------------
; ReadKeyWait - blocking key read that does not flush pending input.
; Irvine32's ReadKey calls ReadKeyFlush after every key, so fast typing (or a
; paste) into ReadChar loses characters.  Reading the console input record
; directly preserves every queued keystroke.
; Returns: EAX = ASCII code (0 for special/extended keys).
; ----------------------------------------------------------------------------
ReadKeyWait PROC USES ebx
    LOCAL hIn:DWORD
    LOCAL rec:INPUT_RECORD
    LOCAL nRead:DWORD

    INVOKE GetStdHandle, STD_INPUT_HANDLE
    mov  hIn, eax
RKW_Retry:
    INVOKE ReadConsoleInput, hIn, ADDR rec, 1, ADDR nRead
    cmp  nRead, 1
    jne  RKW_Retry
    movzx eax, rec.EventType
    cmp  eax, KEY_EVENT
    jne  RKW_Retry
    cmp  rec.Event.bKeyDown, 0
    je   RKW_Retry
    movzx eax, rec.Event.uChar.AsciiChar
    ret
ReadKeyWait ENDP

; ----------------------------------------------------------------------------
; ReadPassword - reads a masked line using ReadKeyWait.
; Receives: pBuffer = destination, maxLen = maximum characters.
; Returns:  EAX = number of characters stored.
; Backspace erases, Enter terminates, printable ASCII is echoed as '*'.
; ----------------------------------------------------------------------------
ReadPassword PROC USES esi, pBuffer:PTR BYTE, maxLen:DWORD
    LOCAL count:DWORD

    mov  count, 0
    mov  esi, pBuffer
RP_Loop:
    call ReadKeyWait                   ; AL = ASCII code
    cmp  al, 13                        ; Enter?
    je   RP_Done
    cmp  al, 8                         ; Backspace?
    je   RP_Backspace
    cmp  al, 32                        ; ignore control characters
    jb   RP_Loop
    cmp  al, 126
    ja   RP_Loop
    mov  ecx, count
    cmp  ecx, maxLen
    jae  RP_Loop                       ; buffer full: ignore extra keys
    mov  BYTE PTR [esi+ecx], al
    inc  count
    mov  al, '*'
    call WriteChar
    jmp  RP_Loop

RP_Backspace:
    cmp  count, 0
    je   RP_Loop
    dec  count
    mov  al, 8                         ; move back, erase, move back again
    call WriteChar
    mov  al, ' '
    call WriteChar
    mov  al, 8
    call WriteChar
    jmp  RP_Loop

RP_Done:
    mov  ecx, count
    mov  BYTE PTR [esi+ecx], 0
    call Crlf
    mov  eax, count
    ret
ReadPassword ENDP

; ----------------------------------------------------------------------------
; ReadNumber - reads and strictly validates an unsigned decimal number.
; Irvine32's ReadDec returns 0 with CF clear when the text is not numeric,
; which would silently turn "abc" into 0 (a cancel/finish request).  This
; routine reads a whole line, accepts optional leading/trailing spaces, and
; sets CF when the line is empty, contains a non-digit, or overflows 32 bits.
; Returns: EAX = value, CF = 0;  EAX = 0, CF = 1 on error.
; ----------------------------------------------------------------------------
ReadNumber PROC USES esi ebx
    LOCAL buf[16]:BYTE
    LOCAL digit:DWORD

    lea  edx, buf
    mov  ecx, 12                       ; up to 11 digits + null terminator
    call ReadString                    ; EAX = characters read
    mov  ecx, eax
    test ecx, ecx
    jz   RN_Error

    lea  esi, buf
RN_Lead:
    mov  al, BYTE PTR [esi]
    cmp  al, ' '
    je   RN_SkipLead
    cmp  al, 9
    je   RN_SkipLead
    jmp  RN_Start
RN_SkipLead:
    inc  esi
    dec  ecx
    jz   RN_Error
    jmp  RN_Lead

RN_Start:
    xor  eax, eax                      ; accumulator
RN_Digit:
    movzx edx, BYTE PTR [esi]
    cmp  dl, ' '
    je   RN_Trail
    cmp  dl, 9
    je   RN_Trail
    sub  edx, '0'
    cmp  edx, 9
    ja   RN_Error                      ; not a decimal digit
    mov  digit, edx
    mov  ebx, 10
    mul  ebx                           ; EAX = EAX * 10
    test edx, edx
    jnz  RN_Error                      ; overflow past 32 bits
    add  eax, digit
    jc   RN_Error
    inc  esi
    dec  ecx
    jz   RN_Ok
    jmp  RN_Digit

RN_Trail:
    mov  dl, BYTE PTR [esi]
    cmp  dl, ' '
    je   RN_TrailNext
    cmp  dl, 9
    jne  RN_Error                      ; junk after the number
RN_TrailNext:
    inc  esi
    dec  ecx
    jz   RN_Ok
    jmp  RN_Trail

RN_Ok:
    clc
    ret
RN_Error:
    xor  eax, eax
    stc
    ret
ReadNumber ENDP

; ----------------------------------------------------------------------------
; VerifyString - exact byte comparison using CMPSB.
; Receives: pStored, pEntered, storedLen, enteredLen.
; Returns:  EAX = 1 if equal, 0 otherwise.
; ----------------------------------------------------------------------------
VerifyString PROC USES esi edi ecx, pStored:PTR BYTE, pEntered:PTR BYTE, storedLen:DWORD, enteredLen:DWORD
    mov  eax, 0
    mov  ecx, storedLen
    cmp  ecx, enteredLen
    jne  VS_Done                       ; different lengths cannot match
    test ecx, ecx
    jz   VS_Match

    mov  esi, pStored
    mov  edi, pEntered
    cld
    repe cmpsb                         ; compare bytes while equal
    jne  VS_Done                       ; ZF=0 means a mismatch

VS_Match:
    mov  eax, 1
VS_Done:
    ret
VerifyString ENDP

