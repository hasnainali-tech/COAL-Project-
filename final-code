    xor  ebx, ebx
STWO_Loop:
    cmp  ebx, TABLE_COUNT
    jae  STWO_Done
    lea  esi, orderLineCount
    cmp  DWORD PTR [esi+ebx*4], 0
    je   STWO_Next
    mov  eax, ebx
    inc  eax
    call WriteDec
    mov  al, ' '
    call WriteChar
STWO_Next:
    inc  ebx
    jmp  STWO_Loop
STWO_Done:
