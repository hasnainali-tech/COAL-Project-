ReserveTable PROC USES esi edi ebx
    LOCAL tableNo:DWORD, row:DWORD, party:DWORD, freeCount:DWORD

    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET tableTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call DrawTableGrid

    call CountReservedTables
    mov  ebx, TABLE_COUNT
    sub  ebx, eax
    mov  freeCount, ebx
    test ebx, ebx
    jnz  RT_Prompt

    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgAllReserved
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

RT_Prompt:
    mov  edx, OFFSET promptTableNo
    call WriteString
    call ReadNumber
    jc   RT_BadTable
    test eax, eax
    jz   RT_Cancelled
    cmp  eax, 1
    jb   RT_BadTable
    cmp  eax, TABLE_COUNT
    ja   RT_BadTable

    mov  tableNo, eax
    dec  eax
    mov  row, eax
    shl  eax, 2                         ; byte offset = row * 4
    lea  esi, tableSeats
    cmp  BYTE PTR [esi+eax], 0
    jne  RT_Occupied

RT_Party:
    mov  edx, OFFSET promptParty
    call WriteString
    call ReadNumber
    jc   RT_BadParty
    test eax, eax
    jz   RT_Cancelled
    cmp  eax, 1
    jb   RT_BadParty
    cmp  eax, SEATS_PER_TABLE
    ja   RT_BadParty
    mov  party, eax

    mov  eax, row
    shl  eax, 2
    lea  edi, tableSeats
    add  edi, eax
    mov  ecx, SEATS_PER_TABLE
    mov  al, 1
    rep  stosb                          ; mark all 4 seats occupied

    mov  eax, row
    lea  esi, tableParty
    mov  edx, party
    mov  BYTE PTR [esi+eax], dl

    call ClearScreen
    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgReservedOK
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  edx, OFFSET msgTableLabel
    call WriteString
    mov  eax, tableNo
    call WriteDec
    mov  edx, OFFSET msgForLabel
    call WriteString
    mov  eax, party
    call WriteDec
    mov  edx, OFFSET msgGuestsLabel
    call WriteString
    call Crlf
    call DrawTableGrid
    call WaitEnter
    ret

RT_BadTable:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidTable
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  RT_Prompt

RT_Occupied:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgTableOccupied
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  RT_Prompt

RT_BadParty:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidParty
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  RT_Party

RT_Cancelled:
