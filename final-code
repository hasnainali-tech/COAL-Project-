TakeOrder PROC USES esi edi ebx
    LOCAL tableNo:DWORD, tableIdx:DWORD, itemIdx:DWORD, availStock:DWORD
    LOCAL qty:DWORD, lineTotal:DWORD, lineBase:DWORD, lineCount:DWORD

    call CountReservedTables
    test eax, eax
    jnz  TO_SelectTable

    call ClearScreen
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgNoReservedTables
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

TO_SelectTable:
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET orderTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  edx, OFFSET msgSelectTable
    call WriteString
    call DrawTableGrid
    call ShowTablesWithOrders

TO_TablePrompt:
    mov  edx, OFFSET promptOrderTable
    call WriteString
    call ReadNumber
    jc   TO_BadTable
    test eax, eax
    jz   TO_Cancel
    cmp  eax, 1
    jb   TO_BadTable
    cmp  eax, TABLE_COUNT
    ja   TO_BadTable

    mov  tableNo, eax
    dec  eax
    mov  tableIdx, eax
    shl  eax, 2
    lea  esi, tableSeats
    cmp  BYTE PTR [esi+eax], 0
    je   TO_TableNotReserved
    jmp  TO_OrderLoop

TO_BadTable:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidTable
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  TO_TablePrompt

TO_TableNotReserved:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgTableNotReserved
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    jmp  TO_TablePrompt

TO_Cancel:
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgOrderCancelled
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

TO_OrderLoop:

    mov  eax, tableIdx
    lea  esi, orderLineCount
    mov  eax, DWORD PTR [esi+eax*4]
    mov  lineCount, eax
    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    mov  lineBase, eax

    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET orderTitle
    call WriteString
    mov  edx, OFFSET msgOrderForTable
    call WriteString
    mov  eax, tableNo
    call WriteDec
    call Crlf
    mov  eax, COLOR_NORMAL
    call SetTextColor

    call PrintMenuTable

    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgItemsCount
    call WriteString
    mov  eax, lineCount
    call WriteDec
    mov  edx, OFFSET msgRunning
    call WriteString
    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  eax, DWORD PTR [esi+eax*4]
    call WriteDec
    call Crlf
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET promptItem
    call WriteString
    call ReadNumber
    jc   TO_BadItem
    test eax, eax
    jz   TO_Finish
    cmp  eax, 1
    jb   TO_BadItem
    cmp  eax, MAX_ITEMS
    ja   TO_BadItem
    dec  eax
    mov  itemIdx, eax

    lea  esi, menuStock
    mov  eax, DWORD PTR [esi+eax*4]
    test eax, eax
    jz   TO_OutOfStock
    mov  availStock, eax

    mov  edx, OFFSET promptQty1
    call WriteString
    mov  eax, availStock
    call WriteDec
    mov  edx, OFFSET promptQty2
    call WriteString
    call ReadNumber
    jc   TO_BadQty
    test eax, eax
    jz   TO_OrderLoop
    cmp  eax, 1
    jb   TO_BadQty
    cmp  eax, availStock
    ja   TO_BadQty
    mov  qty, eax

    INVOKE FindOrderLine, tableIdx, itemIdx
    cmp  eax, -1
    je   TO_NewLine
    mov  ecx, lineBase
    lea  esi, orderQty
    add  esi, ecx
    mov  edx, qty
    add  DWORD PTR [esi+eax*4], edx
    jmp  TO_UpdateStock

TO_NewLine:
    mov  eax, lineCount
    cmp  eax, MAX_ORDER_LINES
    jae  TO_OrderFull
    mov  ecx, lineBase
    lea  esi, orderItem
    add  esi, ecx
    mov  edx, itemIdx
    mov  DWORD PTR [esi+eax*4], edx
    lea  esi, orderQty
    add  esi, ecx
    mov  edx, qty
    mov  DWORD PTR [esi+eax*4], edx
    mov  ecx, tableIdx
    lea  esi, orderLineCount
    inc  DWORD PTR [esi+ecx*4]

TO_UpdateStock:

    mov  eax, itemIdx
    lea  esi, menuStock
    mov  edx, qty
    sub  DWORD PTR [esi+eax*4], edx

    mov  eax, itemIdx
    lea  esi, menuPrices
    mov  eax, DWORD PTR [esi+eax*4]
    mov  ecx, qty
    mul  ecx
    mov  lineTotal, eax
    mov  ebx, edx
    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  ecx, lineTotal
    add  DWORD PTR [esi+eax*4], ecx
    lea  esi, orderSubtotalHi
    adc  DWORD PTR [esi+eax*4], ebx

    mov  edx, OFFSET msgAdded
    call WriteString
    mov  eax, itemIdx
    lea  esi, menuNames
    mov  edx, DWORD PTR [esi+eax*4]
    call WriteString
    mov  edx, OFFSET msgTimes
    call WriteString
    mov  eax, qty
    call WriteDec
    mov  edx, OFFSET msgEquals
    call WriteString
    mov  eax, lineTotal
    call WriteDec
    call Crlf

    mov  edx, OFFSET msgRunning
    call WriteString
    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  eax, DWORD PTR [esi+eax*4]
    call WriteDec
    call Crlf
    call WaitEnter
    jmp  TO_OrderLoop

TO_BadItem:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidItem
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  TO_OrderLoop

TO_OutOfStock:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgOutOfStock
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  TO_OrderLoop

TO_BadQty:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgInvalidQty
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  TO_OrderLoop

TO_OrderFull:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgOrderFull
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    jmp  TO_OrderLoop

TO_Finish:

    mov  eax, tableIdx
    lea  esi, orderLineCount
    cmp  DWORD PTR [esi+eax*4], 0
    jne  TO_FinishWithItems

    call ClearScreen
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET msgOrderEmpty
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret

TO_FinishWithItems:
    call ClearScreen
    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgOrderRecorded
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call Crlf
    mov  edx, OFFSET msgOrderForTable
    call WriteString
    mov  eax, tableNo
    call WriteDec
    call Crlf
    mov  edx, OFFSET msgRunning
    call WriteString
    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  eax, DWORD PTR [esi+eax*4]
    call WriteDec
    call Crlf
    call WaitEnter
    ret
TakeOrder ENDP

ComputeBill PROC USES ebx esi, tableIdx:DWORD
    LOCAL subtotal:DWORD, taxAmt:DWORD, discountAmt:DWORD
    LOCAL finalAmt:DWORD, points:DWORD

    mov  eax, tableIdx
    lea  esi, orderSubtotalLo
    mov  eax, DWORD PTR [esi+eax*4]
    mov  subtotal, eax

    mov  eax, subtotal
    mov  ebx, TAX_PERCENT
    mul  ebx                            ; tax = subtotal * 5 / 100
    mov  ecx, 100
    div  ecx
    mov  taxAmt, eax

    mov  discountAmt, 0
    mov  eax, subtotal
    cmp  eax, DISC_THRESHOLD
    jb   CB_NoDiscount
    shr  eax, 2                         ; 25% discount = subtotal / 4
    mov  discountAmt, eax
CB_NoDiscount:

    mov  eax, subtotal
    add  eax, taxAmt
    sub  eax, discountAmt
    mov  finalAmt, eax

    INVOKE CalcLoyaltyPoints, subtotal
    mov  points, eax

    mov  eax, subtotal
    mov  billSubtotal, eax
    mov  eax, taxAmt
    mov  billTax, eax
    mov  eax, discountAmt
    mov  billDiscount, eax
    mov  eax, finalAmt
    mov  billFinal, eax
    mov  eax, points
    mov  billPoints, eax
    ret
ComputeBill ENDP

; recursive: one point per complete Rs. 100
CalcLoyaltyPoints PROC total:DWORD
    mov  eax, total

    cmp  eax, POINTS_UNIT
    jb   CLP_Zero

    sub  eax, POINTS_UNIT
    INVOKE CalcLoyaltyPoints, eax       ; recursive call
    inc  eax
    ret

CLP_Zero:
    xor  eax, eax
    ret
CalcLoyaltyPoints ENDP

PrintReceipt PROC USES esi edi, tableIdx:DWORD
    LOCAL i:DWORD, itemIdx:DWORD, qty:DWORD, price:DWORD, lineTotal:DWORD
    LOCAL lineBase:DWORD, lineCount:DWORD

    INVOKE ComputeBill, tableIdx
    call ClearScreen

    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET receiptBanner
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET metaReceipt
    call WriteString
    mov  eax, receiptNo
    call WriteDec
    mov  edx, OFFSET metaTable
    call WriteString
    mov  eax, tableIdx
    inc  eax
    call WriteDec
    mov  eax, tableIdx
    lea  esi, tableParty
    movzx eax, BYTE PTR [esi+eax]
    mov  edx, OFFSET metaGuests
    call WriteString
    call WriteDec
    call Crlf

    mov  edx, OFFSET receiptCols
    call WriteString
    mov  edx, OFFSET receiptDivider
    call WriteString

    mov  eax, tableIdx
    lea  esi, orderLineCount
    mov  eax, DWORD PTR [esi+eax*4]
    mov  lineCount, eax
    mov  eax, tableIdx
    imul eax, MAX_ORDER_LINES
    shl  eax, 2
    mov  lineBase, eax

    mov  i, 0
PR_Loop:
    mov  eax, i
    cmp  eax, lineCount
    jae  PR_LinesDone

    mov  ecx, lineBase
    lea  esi, orderItem
    add  esi, ecx
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    mov  itemIdx, eax

    lea  esi, menuNames
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WritePadded, edx, 24

    mov  ecx, lineBase
    lea  esi, orderQty
    add  esi, ecx
    mov  eax, i
    mov  eax, DWORD PTR [esi+eax*4]
    mov  qty, eax
    INVOKE WriteDecPadded, eax, 4

    mov  eax, itemIdx
    lea  esi, menuPrices
    mov  eax, DWORD PTR [esi+eax*4]
    mov  price, eax
    INVOKE WriteDecPadded, eax, 10

    mov  eax, price
    mov  ecx, qty
    mul  ecx
    mov  lineTotal, eax
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    inc  i
    jmp  PR_Loop

PR_LinesDone:
    mov  edx, OFFSET receiptDivider
    call WriteString

    mov  edx, OFFSET lblSubtotal
    INVOKE WritePadded, edx, 44
    mov  eax, billSubtotal
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    cmp  billDiscount, 0
    jne  PR_DiscountPromo
    mov  edx, OFFSET lblDiscountNone
    jmp  PR_DiscountLabel
PR_DiscountPromo:
    mov  edx, OFFSET lblDiscountPromo
PR_DiscountLabel:
    INVOKE WritePadded, edx, 44
    mov  eax, billDiscount
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    mov  edx, OFFSET lblTax
    INVOKE WritePadded, edx, 44
    mov  eax, billTax
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    mov  edx, OFFSET receiptDivider
    call WriteString

    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET lblFinal
    INVOKE WritePadded, edx, 44
    mov  eax, billFinal
    INVOKE WriteDecPadded, eax, 12
    call Crlf
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET lblPoints
    INVOKE WritePadded, edx, 44
    mov  eax, billPoints
    INVOKE WriteDecPadded, eax, 12
    call Crlf

    mov  edx, OFFSET receiptFooter
    call WriteString
    mov  edx, OFFSET msgThankYou
    call WriteString
    ret
PrintReceipt ENDP

