.code
; ==========================================================================
; main : program flow (matches Figure 1 of the proposal)
;        login -> main menu loop -> exit
; ==========================================================================
main PROC
    call InitDataFiles              ; create module .txt files if missing

    call AdminLogin                 ; EAX = 1 valid, 0 locked out
    cmp  eax, 0
    je   quitProgram

mainLoop:
    call ShowMainMenu
    call GetMenuChoice              ; EAX = validated choice 1..5

    cmp  eax, 1
    je   goMenu
    cmp  eax, 2
    je   goTable
    cmp  eax, 3
    je   goOrder
    cmp  eax, 4
    je   goReceipt
    jmp  quitProgram                ; choice 5

goMenu:
    call MenuAndPricing
    jmp  mainLoop
goTable:
    call TableReservation
    jmp  mainLoop
goOrder:
    call OrderProcessing
    jmp  mainLoop
goReceipt:
    call ReceiptDisplay
    jmp  mainLoop

quitProgram:
    mov  edx, OFFSET msgBye
    call WriteString
    exit
main ENDP

; ==========================================================================
; InitDataFiles : creates every module's .txt file (header line only) the
;                 first time the program runs. Existing files are kept.
; ==========================================================================
InitDataFiles PROC
    INVOKE EnsureFile, ADDR fnMenu,    ADDR hdrMenu
    INVOKE EnsureFile, ADDR fnTables,  ADDR hdrTables
    INVOKE EnsureFile, ADDR fnOrders,  ADDR hdrOrders
    INVOKE EnsureFile, ADDR fnBilling, ADDR hdrBilling
    INVOKE EnsureFile, ADDR fnReceipt, ADDR hdrReceipt
    ret
InitDataFiles ENDP

; --------------------------------------------------------------------------
; EnsureFile : creates fname and writes header into it, only if the file
;              does not already exist.
; Receives   : fname  - offset of null-terminated file name
;              header - offset of null-terminated header text
; --------------------------------------------------------------------------
EnsureFile PROC USES eax ebx ecx edx, fname:PTR BYTE, header:PTR BYTE
    mov  edx, fname
    call OpenInputFile              ; EAX = handle or INVALID_HANDLE_VALUE
    cmp  eax, INVALID_HANDLE_VALUE
    jne  alreadyThere

    mov  edx, fname                 ; not found -> create it
    call CreateOutputFile
    cmp  eax, INVALID_HANDLE_VALUE
    je   finished                   ; could not create; skip silently
    mov  ebx, eax                   ; keep the handle

    INVOKE Str_length, header       ; EAX = header length
    mov  ecx, eax
    mov  eax, ebx
    mov  edx, header
    call WriteToFile                ; write header line
    mov  eax, ebx
    call CloseFile
    jmp  finished

alreadyThere:
    call CloseFile                  ; EAX still holds the open handle
finished:
    ret
EnsureFile ENDP

; ==========================================================================
; ShowHeader : shared screen header. Clears the screen and prints a title
;              between two bars. Use it at the top of every module.
; Receives   : titlePtr - offset of null-terminated title text
; ==========================================================================
ShowHeader PROC USES eax edx, titlePtr:PTR BYTE
    call Clrscr
    mov  eax, yellow + (black * 16)
    call SetTextColor
    mov  edx, OFFSET lineBar
    call WriteString
    mov  edx, titlePtr
    call WriteString
    call Crlf
    mov  edx, OFFSET lineBar
    call WriteString
    mov  eax, white + (black * 16)
    call SetTextColor
    call Crlf
    ret
ShowHeader ENDP

; ==========================================================================
; AdminLogin : asks for the administrator password and verifies it with
;              CMPSB. The user gets MAX_TRIES attempts.
; Returns    : EAX = 1 if login succeeded, 0 if locked out
; Validation : empty input is rejected without using up an attempt; the
;              length must match first, then REPE CMPSB compares the bytes.
; ==========================================================================
AdminLogin PROC USES ebx ecx edx esi edi
    mov  ebx, MAX_TRIES             ; EBX = attempts left

askAgain:
    INVOKE ShowHeader, ADDR titleLogin
    mov  edx, OFFSET promptPass
    call WriteString

    mov  edx, OFFSET passBuf
    mov  ecx, MAX_PASS              ; never read more than the buffer holds
    call ReadString                 ; EAX = number of characters typed

    cmp  eax, 0
    jne  haveInput
    mov  edx, OFFSET msgEmpty       ; empty input: retry, no penalty
    call WriteString
    call WaitMsg
    jmp  askAgain

haveInput:
    cmp  eax, ADMIN_LEN             ; different length -> cannot match
    jne  wrongPass

    cld                             ; compare forward
    mov  esi, OFFSET passBuf
    mov  edi, OFFSET adminPass
    mov  ecx, ADMIN_LEN
    repe cmpsb                      ; stops at first mismatch
    jne  wrongPass

    call Crlf                       ; password correct
    mov  edx, OFFSET msgWelcome
    call WriteString
    call WaitMsg
    mov  eax, 1
    jmp  loginDone

wrongPass:
    dec  ebx
    jz   lockedOut
    call Crlf
    mov  edx, OFFSET msgDenied
    call WriteString
    mov  eax, ebx
    call WriteDec
    call Crlf
    call WaitMsg
    jmp  askAgain

lockedOut:
    mov  edx, OFFSET msgLocked
    call WriteString
    mov  eax, 0

loginDone:
    ret
AdminLogin ENDP

; ==========================================================================
; ShowMainMenu : draws the main menu screen.
; ==========================================================================
ShowMainMenu PROC USES eax edx
    INVOKE ShowHeader, ADDR titleMain
    mov  edx, OFFSET menuItem1
    call WriteString
    mov  edx, OFFSET menuItem2
    call WriteString
    mov  edx, OFFSET menuItem3
    call WriteString
    mov  edx, OFFSET menuItem4
    call WriteString
    mov  edx, OFFSET menuItem5
    call WriteString
    call Crlf
    ret
ShowMainMenu ENDP

; ==========================================================================
; GetMenuChoice : reads and validates the main menu selection.
; Returns       : EAX = a number from MENU_MIN to MENU_MAX
; Validation    : ReadInt sets the Overflow flag when the text is not a
;                 valid number, so letters and symbols are rejected; the
;                 value is then range-checked. Repeats until valid.
; ==========================================================================
GetMenuChoice PROC USES edx
tryAgain:
    mov  edx, OFFSET promptChoice
    call WriteString
    call ReadInt                    ; EAX = value, OF = 1 if invalid text
    jo   badInput
    cmp  eax, MENU_MIN
    jl   badInput
    cmp  eax, MENU_MAX
    jg   badInput
    ret                             ; valid choice in EAX

badInput:
    mov  edx, OFFSET msgBadChoice
    call WriteString
    jmp  tryAgain
GetMenuChoice ENDP

