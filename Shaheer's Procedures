AdminLogin PROC
LoginRetry:
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET loginBanner
    call WriteString

    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET loginHint
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET promptUser
    call WriteString
    mov  edx, OFFSET userBuf
    mov  ecx, 32
    call ReadString

    mov  edx, OFFSET promptPass
    call WriteString
    INVOKE ReadPassword, OFFSET passBuf, 32

    INVOKE Str_length, OFFSET userBuf
    INVOKE VerifyString, OFFSET adminUser, OFFSET userBuf, ADMIN_USER_LEN, eax
    test eax, eax
    jz   LoginFailed

    INVOKE Str_length, OFFSET passBuf
    INVOKE VerifyString, OFFSET adminPass, OFFSET passBuf, ADMIN_PASS_LEN, eax
    test eax, eax
    jz   LoginFailed

    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgLoginOK
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  eax, 800
    call Delay
    ret

LoginFailed:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgBadLogin
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  eax, 1200
    call Delay
    jmp  LoginRetry
AdminLogin ENDP

ReadKeyWait PROC USES ebx
    LOCAL hIn:DWORD
    LOCAL rec:INPUT_RECORD
    LOCAL nRead:DWORD

    INVOKE GetStdHandle, STD_INPUT_HANDLE
    mov  hIn, eax
RKW_Retry:
    INVOKE ReadConsoleInput, hIn, ADDR rec, 1, ADDR nRead
    cmp  nRead, 1
    jne  RKW_Retry
    movzx eax, rec.EventType
    cmp  eax, KEY_EVENT
    jne  RKW_Retry
    cmp  rec.Event.bKeyDown, 0
    je   RKW_Retry
    movzx eax, rec.Event.uChar.AsciiChar
    ret
ReadKeyWait ENDP

ReadPassword PROC USES esi, pBuffer:PTR BYTE, maxLen:DWORD
    LOCAL count:DWORD

    mov  count, 0
    mov  esi, pBuffer
RP_Loop:
    call ReadKeyWait
    cmp  al, 13
    je   RP_Done
    cmp  al, 8
    je   RP_Backspace
    cmp  al, 32
    jb   RP_Loop
    cmp  al, 126
    ja   RP_Loop
    mov  ecx, count
    cmp  ecx, maxLen
    jae  RP_Loop
    mov  BYTE PTR [esi+ecx], al
    inc  count
    mov  al, '*'
    call WriteChar
    jmp  RP_Loop

RP_Backspace:
    cmp  count, 0
    je   RP_Loop
    dec  count
    mov  al, 8
    call WriteChar
    mov  al, ' '
    call WriteChar
    mov  al, 8
    call WriteChar
    jmp  RP_Loop

RP_Done:
    mov  ecx, count
    mov  BYTE PTR [esi+ecx], 0
    call Crlf
    mov  eax, count
    ret
ReadPassword ENDP

ReadNumber PROC USES esi ebx
    LOCAL buf[16]:BYTE
    LOCAL digit:DWORD

    lea  edx, buf
    mov  ecx, 12
    call ReadString
    mov  ecx, eax
    test ecx, ecx
    jz   RN_Error

    lea  esi, buf
RN_Lead:
    mov  al, BYTE PTR [esi]
    cmp  al, ' '
    je   RN_SkipLead
    cmp  al, 9
    je   RN_SkipLead
    jmp  RN_Start
RN_SkipLead:
    inc  esi
    dec  ecx
    jz   RN_Error
    jmp  RN_Lead

RN_Start:
    xor  eax, eax
RN_Digit:
    movzx edx, BYTE PTR [esi]
    cmp  dl, ' '
    je   RN_Trail
    cmp  dl, 9
    je   RN_Trail
    sub  edx, '0'
    cmp  edx, 9
    ja   RN_Error
    mov  digit, edx
    mov  ebx, 10
    mul  ebx
    test edx, edx
    jnz  RN_Error
    add  eax, digit
    jc   RN_Error
    inc  esi
    dec  ecx
    jz   RN_Ok
    jmp  RN_Digit

RN_Trail:
    mov  dl, BYTE PTR [esi]
    cmp  dl, ' '
    je   RN_TrailNext
    cmp  dl, 9
    jne  RN_Error
RN_TrailNext:
    inc  esi
    dec  ecx
    jz   RN_Ok
    jmp  RN_Trail

RN_Ok:
    clc
    ret
RN_Error:
    xor  eax, eax
    stc
    ret
ReadNumber ENDP

VerifyString PROC USES esi edi ecx, pStored:PTR BYTE, pEntered:PTR BYTE, storedLen:DWORD, enteredLen:DWORD
    mov  eax, 0
    mov  ecx, storedLen
    cmp  ecx, enteredLen
    jne  VS_Done
    test ecx, ecx
    jz   VS_Match

    mov  esi, pStored
    mov  edi, pEntered
    cld
    repe cmpsb
    jne  VS_Done

VS_Match:
    mov  eax, 1
VS_Done:
    ret
VerifyString ENDP

ShowMainMenu PROC
MenuRetry:
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET mainMenuBanner
    call WriteString
    call ShowStatusLine

    mov  eax, COLOR_MENU
    call SetTextColor
    mov  edx, OFFSET mainMenuOptions
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  edx, OFFSET promptChoice
    call WriteString
    call ReadNumber
    jc   MenuBad
    cmp  eax, 1
    jb   MenuBad
    cmp  eax, 7
    ja   MenuBad
    ret

MenuBad:
    mov  eax, COLOR_ERROR
    call SetTextColor
    mov  edx, OFFSET msgBadChoice
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  eax, 700
    call Delay
    jmp  MenuRetry
ShowMainMenu ENDP

ShowStatusLine PROC
    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET statusPrefix
    call WriteString

    call CountActiveOrders
    test eax, eax
    jz   SSL_Idle
    push eax
    mov  edx, OFFSET msgStatusActive
    call WriteString
    pop  eax
    call WriteDec
    jmp  SSL_Tables
SSL_Idle:
    mov  edx, OFFSET msgStatusIdle
    call WriteString

SSL_Tables:
    mov  edx, OFFSET msgTablesReserved
    call WriteString
    call CountReservedTables
    call WriteDec
    mov  edx, OFFSET msgOf
    call WriteString
    mov  eax, TABLE_COUNT
    call WriteDec

    mov  edx, OFFSET msgReceipts
    call WriteString
    mov  eax, receiptNo
    dec  eax
    call WriteDec
    call Crlf

    mov  eax, COLOR_NORMAL
    call SetTextColor
    ret
ShowStatusLine ENDP

WritePadded PROC pString:PTR BYTE, fieldWidth:DWORD
    LOCAL len:DWORD, pad:DWORD
    INVOKE Str_length, pString
    mov  len, eax
    mov  edx, pString
    call WriteString

    mov  eax, fieldWidth
    sub  eax, len
    jbe  WP_Done
    mov  pad, eax
WP_Spaces:
    mov  al, ' '
    call WriteChar
    dec  pad
    jnz  WP_Spaces
WP_Done:
    ret
WritePadded ENDP

WriteDecPadded PROC USES ebx, value:DWORD, fieldWidth:DWORD
    LOCAL digits:DWORD, pad:DWORD, val:DWORD
    mov  eax, value
    mov  val, eax
    mov  digits, 1
    cmp  eax, 10
    jb   WDP_Print
    mov  ebx, 10
WDP_Count:
    xor  edx, edx
    div  ebx
    inc  digits
    cmp  eax, 10
    jae  WDP_Count
WDP_Print:
    mov  eax, fieldWidth
    sub  eax, digits
    jbe  WDP_Value
    mov  pad, eax
WDP_Spaces:
    mov  al, ' '
    call WriteChar
    dec  pad
    jnz  WDP_Spaces
WDP_Value:
    mov  eax, val
    call WriteDec
    ret
WriteDecPadded ENDP

ClearScreen PROC USES edi ebx
    LOCAL info:CONSOLE_SCREEN_BUFFER_INFO
    LOCAL origin:COORD
    LOCAL written:DWORD
    LOCAL fieldWidth:DWORD
    LOCAL row:DWORD

    INVOKE GetStdHandle, STD_OUTPUT_HANDLE
    mov  ebx, eax
    INVOKE GetConsoleScreenBufferInfo, ebx, ADDR info

    movzx eax, info.srWindow.Right
    movzx ecx, info.srWindow.Left
    sub  eax, ecx
    inc  eax
    cmp  eax, MAX_CLEAR_COLS
    jbe  CS_WidthOK
    mov  eax, MAX_CLEAR_COLS
CS_WidthOK:
    mov  fieldWidth, eax

    mov  ax, info.wAttributes
    mov  ecx, fieldWidth
    mov  edi, OFFSET clearAttribs
    rep  stosw

    mov  origin.X, 0
    movzx eax, info.srWindow.Top
    mov  row, eax
CS_Row:
    mov  eax, row
    movzx ecx, info.srWindow.Bottom
    cmp  eax, ecx
    ja   CS_Done
    mov  origin.Y, ax
    INVOKE WriteConsoleOutputCharacter, ebx, ADDR clearBlanks, fieldWidth, origin, ADDR written
    INVOKE WriteConsoleOutputAttribute, ebx, ADDR clearAttribs, fieldWidth, origin, ADDR written
    inc  row
    jmp  CS_Row

CS_Done:
    mov  origin.X, 0
    movzx eax, info.srWindow.Top
    mov  origin.Y, ax
    INVOKE SetConsoleCursorPosition, ebx, origin
    ret
ClearScreen ENDP

WaitEnter PROC
    mov  edx, OFFSET msgPressAnyKey
    call WriteString
    call ReadKeyWait
    call Crlf
    ret
WaitEnter ENDP

ViewMenu PROC
    call ClearScreen
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET menuTitle
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    call PrintMenuTable

    mov  eax, COLOR_DIM
    call SetTextColor
    mov  edx, OFFSET menuFooter
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    call WaitEnter
    ret
ViewMenu ENDP

PrintMenuTable PROC USES esi
    LOCAL i:DWORD
    mov  eax, COLOR_HEADER
    call SetTextColor
    mov  edx, OFFSET menuTableHeader
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor

    mov  i, 0
PMT_Loop:
    mov  eax, i
    cmp  eax, MAX_ITEMS
    jae  PMT_Done

    inc  eax
    INVOKE WriteDecPadded, eax, 3
    mov  edx, OFFSET colSep
    call WriteString

    mov  eax, i
    lea  esi, menuNames
    mov  edx, DWORD PTR [esi+eax*4]
    INVOKE WritePadded, edx, 24

    mov  eax, i
    lea  esi, menuPrices
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 9

    mov  eax, i
    lea  esi, menuStock
    mov  eax, DWORD PTR [esi+eax*4]
    INVOKE WriteDecPadded, eax, 7
    call Crlf

    inc  i
    jmp  PMT_Loop
PMT_Done:
    mov  edx, OFFSET menuDivider
    call WriteString
    ret
PrintMenuTable ENDP

Goodbye PROC
    call ClearScreen
    mov  eax, COLOR_SUCCESS
    call SetTextColor
    mov  edx, OFFSET msgGoodbye
    call WriteString
    mov  eax, COLOR_NORMAL
    call SetTextColor
    mov  edx, OFFSET msgGroup
    call WriteString
    call WaitEnter
    ret
Goodbye ENDP
